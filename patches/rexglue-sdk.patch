+/**
+ * @file        core/ps4_call_counter.cpp
+ * @brief       Registry behind rex/ps4_call_counter.h
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/ps4_call_counter.h>
+
+namespace rex::ps4 {
+namespace {
+std::atomic<CallCounter*> g_head{nullptr};
+}  // namespace
+
+CallCounter::CallCounter(const char* counter_name) : name(counter_name) {
+  CallCounter* head = g_head.load(std::memory_order_relaxed);
+  do {
+    next = head;
+  } while (!g_head.compare_exchange_weak(head, this, std::memory_order_release,
+                                         std::memory_order_relaxed));
+}
+
+CallCounter* CallCounters() {
+  return g_head.load(std::memory_order_acquire);
+}
+
+}  // namespace rex::ps4
diff --git a/src/core/ps4_rpmalloc/ps4_malloc.c b/src/core/ps4_rpmalloc/ps4_malloc.c
new file mode 100644
index 0000000..2eb1ae3
--- /dev/null
+++ b/src/core/ps4_rpmalloc/ps4_malloc.c
@@ -0,0 +1,243 @@
+/**
+ * @file        core/ps4_rpmalloc/ps4_malloc.c
+ * @brief       The process's malloc on the PS4: rpmalloc on direct memory
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *              rpmalloc.c / rpmalloc.h: public domain, Mattias Jansson (rpmalloc 1.4.5).
+ *
+ * The C library's malloc takes its pages from flexible memory, a ~450 MB pool per title. Skate 3
+ * plus the native renderer left 13 MB of it in free roam and crashed on the next allocation
+ * (bad_alloc on the GPU thread). Direct memory is 4.5 GB, most of it unused, so every malloc,
+ * free and operator new (libc++ allocates through malloc) in the process now goes to rpmalloc,
+ * whose pages come from 64 MB chunks of direct memory. rpmalloc is also a thread-caching allocator,
+ * much cheaper than the libc one under the contention a recompiled 360 game produces.
+ *
+ * Pages handed back by rpmalloc are recycled here, never returned to the system.
+ */
+
+#define RPMALLOC_PS4 1
+#define ENABLE_PRELOAD 0
+#define ENABLE_OVERRIDE 0
+#define ENABLE_STATISTICS 0
+#define ENABLE_ASSERTS 0
+#define ENABLE_ADAPTIVE_THREAD_CACHE 1
+
+#include <errno.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/types.h>
+
+struct rpmalloc_config_t;
+static const struct rpmalloc_config_t* rpmalloc_ps4_config(void);
+static void rpmalloc_ps4_thread_attached(void);
+
+#include "rpmalloc.c"
+
+int32_t sceKernelAllocateDirectMemory(off_t search_start, off_t search_end, size_t length,
+                                      size_t alignment, int32_t memory_type, off_t* phys_out);
+int32_t sceKernelMapDirectMemory(void** addr, size_t length, int32_t prot, int32_t flags,
+                                 off_t direct_start, size_t alignment);
+size_t sceKernelGetDirectMemorySize(void);
+
+#define PS4_HEAP_CHUNK ((size_t)64 << 20)
+#define PS4_HEAP_ALIGN ((size_t)64 << 10)
+#define PS4_HEAP_MAX_FREE 8192
+
+typedef struct {
+  uintptr_t addr;
+  size_t size;
+} ps4_range_t;
+
+static volatile int g_ps4_heap_lock;
+// Diagnostics, read by the PS4 memory log line (windowed_app_main_ps4.cpp).
+static size_t g_ps4_heap_direct_bytes;
+static size_t g_ps4_heap_flexible_bytes;
+static uint32_t g_ps4_heap_failures;
+static int32_t g_ps4_heap_last_error;
+static uintptr_t g_ps4_heap_cur;
+static uintptr_t g_ps4_heap_end;
+static ps4_range_t g_ps4_heap_free[PS4_HEAP_MAX_FREE];
+static size_t g_ps4_heap_free_count;
+
+static void ps4_heap_lock(void) {
+  while (__atomic_exchange_n(&g_ps4_heap_lock, 1, __ATOMIC_ACQUIRE)) {
+    while (__atomic_load_n(&g_ps4_heap_lock, __ATOMIC_RELAXED)) sched_yield();
+  }
+}
+
+static void ps4_heap_unlock(void) {
+  __atomic_store_n(&g_ps4_heap_lock, 0, __ATOMIC_RELEASE);
+}
+
+static void ps4_heap_add_free_locked(uintptr_t addr, size_t size) {
+  if (size && g_ps4_heap_free_count < PS4_HEAP_MAX_FREE) {
+    g_ps4_heap_free[g_ps4_heap_free_count].addr = addr;
+    g_ps4_heap_free[g_ps4_heap_free_count].size = size;
+    ++g_ps4_heap_free_count;
+  }
+}
+
+int32_t sceKernelAvailableFlexibleMemorySize(size_t* size);
+
+#define PS4_HEAP_STEP ((size_t)16 << 20)
+#define PS4_FLEXIBLE_RESERVE ((size_t)96 << 20)  // left for everything that is not malloc
+
+static void* ps4_map_flexible(size_t length) {
+  // Over-map by one alignment unit: anonymous mappings are only 16 KB aligned.
+  void* p = mmap(0, length + PS4_HEAP_ALIGN, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+  if (p == MAP_FAILED) return 0;
+  g_ps4_heap_flexible_bytes += length;
+  return (void*)(((uintptr_t)p + PS4_HEAP_ALIGN - 1) & ~(PS4_HEAP_ALIGN - 1));
+}
+
+static void* ps4_map_direct(size_t length) {
+  off_t phys = 0;
+  void* base = 0;
+  int32_t err = sceKernelAllocateDirectMemory(0, (off_t)sceKernelGetDirectMemorySize(), length,
+                                              PS4_HEAP_ALIGN, 0 /* WB_ONION */, &phys);
+  if (err == 0) {
+    err = sceKernelMapDirectMemory(&base, length, 0x3 /* CPU RW */, 0, phys, PS4_HEAP_ALIGN);
+  }
+  if (err != 0) {
+    g_ps4_heap_last_error = err;
+    ++g_ps4_heap_failures;
+    return 0;
+  }
+  g_ps4_heap_direct_bytes += length;
+  return base;
+}
+
+static void* ps4_heap_new_chunk(size_t size, size_t* chunk_out) {
+  const size_t chunk = size > PS4_HEAP_STEP ? size : PS4_HEAP_STEP;
+  size_t flexible_free = 0;
+  sceKernelAvailableFlexibleMemorySize(&flexible_free);
+  void* base = 0;
+  if (flexible_free > PS4_FLEXIBLE_RESERVE + chunk && (base = ps4_map_flexible(chunk))) {
+    *chunk_out = chunk;
+    return base;
+  }
+  if ((base = ps4_map_direct(chunk))) {
+    *chunk_out = chunk;
+    return base;
+  }
+  if (chunk != size && (base = ps4_map_direct(size))) {
+    *chunk_out = size;
+    return base;
+  }
+  if ((base = ps4_map_flexible(size))) {
+    *chunk_out = size;
+    return base;
+  }
+  return 0;
+}
+
+static void* ps4_heap_map(size_t size, size_t* offset) {
+  *offset = 0;
+  size = (size + PS4_HEAP_ALIGN - 1) & ~(PS4_HEAP_ALIGN - 1);
+  ps4_heap_lock();
+  // Best fit among recycled ranges.
+  size_t best = PS4_HEAP_MAX_FREE;
+  for (size_t i = 0; i < g_ps4_heap_free_count; ++i) {
+    if (g_ps4_heap_free[i].size >= size &&
+        (best == PS4_HEAP_MAX_FREE || g_ps4_heap_free[i].size < g_ps4_heap_free[best].size)) {
+      best = i;
+    }
+  }
+  if (best != PS4_HEAP_MAX_FREE) {
+    const uintptr_t addr = g_ps4_heap_free[best].addr;
+    if (g_ps4_heap_free[best].size > size) {
+      g_ps4_heap_free[best].addr += size;
+      g_ps4_heap_free[best].size -= size;
+    } else {
+      g_ps4_heap_free[best] = g_ps4_heap_free[--g_ps4_heap_free_count];
+    }
+    ps4_heap_unlock();
+    memset((void*)addr, 0, size);  // rpmalloc expects fresh pages to read as zero
+    return (void*)addr;
+  }
+  if (g_ps4_heap_end - g_ps4_heap_cur < size) {
+    size_t chunk = 0;
+    void* base = ps4_heap_new_chunk(size, &chunk);
+    if (!base) {
+      ps4_heap_unlock();
+      return 0;
+    }
+    memset(base, 0, chunk);
+    ps4_heap_add_free_locked(g_ps4_heap_cur, g_ps4_heap_end - g_ps4_heap_cur);
+    g_ps4_heap_cur = (uintptr_t)base;
+    g_ps4_heap_end = (uintptr_t)base + chunk;
+  }
+  const uintptr_t addr = g_ps4_heap_cur;
+  g_ps4_heap_cur += size;
+  ps4_heap_unlock();
+  return (void*)addr;
+}
+
+static void ps4_heap_unmap(void* address, size_t size, size_t offset, size_t release) {
+  (void)size;
+  if (!release) {
+    return;  // a partial decommit: the pages simply stay mapped
+  }
+  const uintptr_t addr = (uintptr_t)address - offset;
+  const size_t length = (release + PS4_HEAP_ALIGN - 1) & ~(PS4_HEAP_ALIGN - 1);
+  ps4_heap_lock();
+  ps4_heap_add_free_locked(addr, length);
+  ps4_heap_unlock();
+}
+
+static rpmalloc_config_t g_ps4_rpmalloc_config;
+
+static const struct rpmalloc_config_t* rpmalloc_ps4_config(void) {
+  g_ps4_rpmalloc_config.memory_map = ps4_heap_map;
+  g_ps4_rpmalloc_config.memory_unmap = ps4_heap_unmap;
+  g_ps4_rpmalloc_config.span_map_count = 4;
+  return &g_ps4_rpmalloc_config;
+}
+
+// A thread's cached pages go back to the global pool when it exits.
+static pthread_key_t g_ps4_thread_key;
+static pthread_once_t g_ps4_thread_key_once = PTHREAD_ONCE_INIT;
+
+static void ps4_thread_exit(void* value) {
+  (void)value;
+  rpmalloc_thread_finalize(1);
+}
+
+static void ps4_make_thread_key(void) {
+  pthread_key_create(&g_ps4_thread_key, ps4_thread_exit);
+}
+
+static void rpmalloc_ps4_thread_attached(void) {
+  pthread_once(&g_ps4_thread_key_once, ps4_make_thread_key);
+  pthread_setspecific(g_ps4_thread_key, (void*)1);
+}
+
+// ---- the C allocation API ----
+
+void* malloc(size_t size) { return rpmalloc(size); }
+void* calloc(size_t count, size_t size) { return rpcalloc(count, size); }
+void* realloc(void* ptr, size_t size) { return rprealloc(ptr, size); }
+void free(void* ptr) { rpfree(ptr); }
+void* aligned_alloc(size_t alignment, size_t size) { return rpaligned_alloc(alignment, size); }
+void* memalign(size_t alignment, size_t size) { return rpmemalign(alignment, size); }
+int posix_memalign(void** out, size_t alignment, size_t size) {
+  return rpposix_memalign(out, alignment, size);
+}
+size_t malloc_usable_size(void* ptr) { return rpmalloc_usable_size(ptr); }
+void* valloc(size_t size) { return rpaligned_alloc(16384, size); }
+void* pvalloc(size_t size) { return rpaligned_alloc(16384, (size + 16383) & ~(size_t)16383); }
+
+// For the memory log line: bytes of direct memory the heap owns, bytes it had to take from the
+// flexible pool, and failed direct-memory requests (with the last error).
+void rex_ps4_heap_stats(size_t* direct_bytes, size_t* flexible_bytes, uint32_t* failures,
+                        int32_t* last_error) {
+  *direct_bytes = g_ps4_heap_direct_bytes;
+  *flexible_bytes = g_ps4_heap_flexible_bytes;
+  *failures = g_ps4_heap_failures;
+  *last_error = g_ps4_heap_last_error;
+}
