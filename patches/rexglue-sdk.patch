+/**
+ * @file        rex/input/ps4/ps4_input_driver.h
+ * @brief       PS4 controller input (scePad) presented as an Xbox 360 pad
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <mutex>
+
+#include <rex/input/input_driver.h>
+
+namespace rex::input::ps4 {
+
+class PS4InputDriver final : public InputDriver {
+ public:
+  explicit PS4InputDriver(rex::ui::Window* window, size_t window_z_order);
+  ~PS4InputDriver() override;
+
+  X_STATUS Setup() override;
+  X_RESULT GetCapabilities(uint32_t user_index, uint32_t flags,
+                           X_INPUT_CAPABILITIES* out_caps) override;
+  X_RESULT GetState(uint32_t user_index, X_INPUT_STATE* out_state) override;
+  X_RESULT GetStateUi(uint32_t user_index, X_INPUT_STATE* out_state) override;
+  X_RESULT SetState(uint32_t user_index, X_INPUT_VIBRATION* vibration) override;
+  X_RESULT GetKeystroke(uint32_t user_index, uint32_t flags,
+                        X_INPUT_KEYSTROKE* out_keystroke) override;
+
+ private:
+  X_RESULT ReadState(uint32_t user_index, X_INPUT_STATE* out_state);
+
+  static uint64_t AnalogToKeyfield(const X_INPUT_GAMEPAD& gamepad);
+
+  std::mutex lock_;
+  int32_t handle_ = -1;
+  uint32_t packet_number_ = 0;
+  X_INPUT_GAMEPAD last_{};
+
+  // XInputGetKeystroke emulation, as the SDL driver does it: button (and analog-derived) edges
+  // become KEYDOWN/KEYUP events, a held button repeats.
+  enum class RepeatState { Idle, Waiting, Repeating };
+  uint64_t keystroke_buttons_ = 0;
+  RepeatState repeat_state_ = RepeatState::Idle;
+  uint8_t repeat_index_ = 0;
+  uint64_t repeat_time_ = 0;
+};
+
+}  // namespace rex::input::ps4
