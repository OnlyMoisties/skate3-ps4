diff --git a/include/rex/ppc/intrinsics.h b/include/rex/ppc/intrinsics.h
index 7ad1139..f31496a 100644
--- a/include/rex/ppc/intrinsics.h
+++ b/include/rex/ppc/intrinsics.h
@@ -18,6 +18,20 @@
 #include <cmath>
 #include <cstring>
 
+#if defined(__PS4__)
+// Recompiled fmadd/fmsub call std::fma. The PS4's Jaguar cores have no FMA unit, so without
+// this every one is an out-of-line call (and was the C library's exact software fma before
+// core/fma_ps4.cpp). Inline multiply-then-add, as Xenia does on hosts without FMA; the last bit
+// can differ from a fused result. Needs -fno-builtin-fma (skate3 CMakeLists), or the compiler
+// lowers the call through its fma builtin and never sees this body.
+extern "C" inline double fma(double x, double y, double z) {
+  return x * y + z;
+}
+extern "C" inline float fmaf(float x, float y, float z) {
+  return float(double(x) * double(y) + double(z));
+}
+#endif
+
 #include <simde/x86/avx.h>
 #include <simde/x86/avx2.h>
 #include <simde/x86/fma.h>
diff --git a/include/rex/ps4_call_counter.h b/include/rex/ps4_call_counter.h
new file mode 100644
index 0000000..b826e67
--- /dev/null
+++ b/include/rex/ps4_call_counter.h
@@ -0,0 +1,31 @@
+/**
+ * @file        rex/ps4_call_counter.h
+ * @brief       Per-export call counts for the PS4 sampling profiler
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * Every REX_HOOK (and so every kernel export) on the PS4 build owns one of these; the profiler
+ * in windowed_app_main_ps4.cpp writes how often each was called per window, which tells a guest
+ * thread spinning on, say, KeDelayExecutionThread apart from one doing real work.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace rex::ps4 {
+
+struct CallCounter {
+  explicit CallCounter(const char* counter_name);
+  const char* name;
+  std::atomic<uint64_t> count{0};
+  uint64_t reported = 0;  // profiler-thread only
+  CallCounter* next = nullptr;
+};
+
+// Head of the list every CallCounter links itself into at static initialisation.
+CallCounter* CallCounters();
+
+}  // namespace rex::ps4
