+
+namespace rex {
+namespace ui {
+
+class PS4Window final : public Window {
+  using super = Window;
+
+ public:
+  // The display the swapchain is created for. mesa-ps4 registers its VideoOut buffers at the
+  // swapchain's size, so this is also the scan-out resolution.
+  static constexpr uint32_t kDisplayWidth = 1920;
