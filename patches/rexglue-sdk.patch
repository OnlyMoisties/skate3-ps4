+}  // namespace
+
+int main(int, char**) {
+  mkdir(REX_PS4_DATA_DIR, 0777);
+  {
+    struct stat st;
+    g_debug = stat(REX_PS4_DATA_DIR "/debug.txt", &st) == 0;
+  }
+  unlink(REX_PS4_DATA_DIR "/boot.txt");
+  unlink(REX_PS4_DATA_DIR "/crash.txt");
+  InstallCrashReporter();
+  BootMark("main entered");
+  // Code that looks for a home directory finds the app's data folder instead of nothing.
+  setenv("HOME", REX_PS4_DATA_DIR, 0);
+  sceUserServiceInitialize(nullptr);  // the pad and audio drivers need the user service
+  // A package with a launch splash (sce_sys/pic0.png) keeps it over the display until told.
+  sceSystemServiceHideSplashScreen();
+  Notify("Skate 3 PS4\nCompiled by XeMoisties | CyprusNetwork");
+
+  InstallDefaults();
+  // GPU memory arena for mesa's PS4 driver: the 1 GB default is eaten by the 512 MB shared-memory
+  // buffer. args.txt ("env ORBIS_ARENA_MIB=...") can still override it.
+  setenv("ORBIS_ARENA_MIB", "2048", 0);
+  if (!FileExists(REX_PS4_DATA_DIR "/game/default.xex") && FileExists("/app0/game/default.xex")) {
+    g_game_root = "/app0/game";  // all-in-one package
+  }
+  BootMark(("game files: " + g_game_root).c_str());
+  if (!FileExists((g_game_root + "/default.xex").c_str())) {
+    BootMark("game files missing");
+    Notify("Skate 3: game files not found.\nCopy the extracted Xbox 360 disc (default.xex, data/ "
+           "...) plus the TU3 .xexp files to " REX_PS4_DATA_DIR "/game");
+    Idle(EXIT_FAILURE);
+  }
+  std::vector<std::string> arg_storage = BuildArguments();
+  std::vector<char*> argv;
+  for (auto& a : arg_storage) argv.push_back(a.data());
+  argv.push_back(nullptr);
+  for (size_t i = 1; i + 1 < argv.size(); i++) DebugOut(std::string("rexglue: arg ") + argv[i]);
+
+  BootMark("parsing arguments");
+  auto remaining = rex::cvar::Init(int(argv.size() - 1), argv.data());
+  rex::cvar::ApplyEnvironment();
+  BootMark("starting the log");
+  rex::InitLoggingEarly();
+  BootMark("log started");
+
+  int result = EXIT_FAILURE;
+  {
+    rex::ui::PS4WindowedAppContext app_context;
+    std::unique_ptr<rex::ui::WindowedApp> app = rex::ui::GetWindowedAppCreator()(app_context);
+
+    const auto& option_names = app->GetPositionalOptions();
+    std::map<std::string, std::string> parsed;
+    size_t count = std::min(remaining.size(), option_names.size());
+    for (size_t i = 0; i < count; ++i) {
+      parsed[option_names[i]] = remaining[i];
+    }
+    app->SetParsedArguments(std::move(parsed));
+
+    BootMark("app created; initializing");
+    bool initialized = app->OnInitialize();
+    BootMark(initialized ? "app initialized; entering the UI loop" : "app failed to initialize");
+    if (initialized) StartProfilerIfRequested();
+    if (initialized) {
+      int stack_marker = 0;
+      if (g_debug) StartStallWatchdog(uint64_t(&stack_marker));
+    }
+    DebugOut(initialized ? "rexglue: app initialized, entering the UI loop"
+                         : "rexglue: app failed to initialize (see the log)");
+    result = initialized ? app_context.RunMainLoop() : EXIT_FAILURE;
+    // As on macOS: guest threads cannot be stopped reliably, so skip teardown, flush the log and
+    // leave everything to the process's end.
+    rex::FlushLogging();
+  }
+  Idle(result);
+}
