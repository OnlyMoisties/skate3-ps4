index f08e31e..e7ec174 100644
--- a/src/kernel/xam/xam_ui.cpp
+++ b/src/kernel/xam/xam_ui.cpp
@@ -9,7 +9,13 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <algorithm>
+#include <chrono>
+#include <mutex>
+#include <vector>
+
 #include <rex/logging.h>
+#include <rex/platform.h>
 #include <rex/runtime.h>
 #include <rex/string.h>
 #include <rex/string/util.h>
@@ -424,6 +430,115 @@ class KeyboardInputDialog : public XamDialog {
 };
 
 // https://www.se7ensins.com/forums/threads/release-how-to-use-xshowkeyboardui-release.906568/
+#if REX_PLATFORM_PS4
+// ---- PS4: XamShowKeyboardUI through the system on-screen keyboard (sceImeDialog) ----
+//
+// The imgui keyboard dialog needs a physical keyboard; on the console the game would wait on it
+// forever behind a black screen (Skate 3's board-company name entry). SCE's wchar_t is 16-bit
+// UTF-16, the toolchain's is 32-bit, so the parameter block is declared here with char16_t.
+extern "C" {
+int32_t sceSysmoduleLoadModule(uint16_t id);
+int32_t sceCommonDialogInitialize();
+int32_t sceUserServiceGetInitialUser(int32_t* user_id);
+int32_t sceImeDialogInit(const void* param, void* param_extended);
+int32_t sceImeDialogGetStatus();
+int32_t sceImeDialogGetResult(void* result);
+int32_t sceImeDialogTerm();
+}
+
+namespace {
+
+struct Ps4ImeDialogParam {
+  int32_t user_id;
+  int32_t type;
+  uint64_t supported_languages;
+  int32_t enter_label;
+  int32_t input_method;
+  void* filter;
+  uint32_t option;
+  uint32_t max_text_length;
+  char16_t* input_text_buffer;
+  float posx;
+  float posy;
+  int32_t horizontal_alignment;
+  int32_t vertical_alignment;
+  const char16_t* placeholder;
+  const char16_t* title;
+  int8_t reserved[16];
+};
+static_assert(sizeof(Ps4ImeDialogParam) == 0x60, "SceImeDialogParam layout");
+
+struct Ps4DialogResult {
+  int32_t end_status;  // 0 ok, 1 cancel, 2 aborted
+  int8_t reserved[12];
+};
+
+std::mutex g_ps4_ime_lock;
+
+// Blocks until the user closes the keyboard. Returns false when cancelled or unavailable.
+bool Ps4ShowImeKeyboard(std::u16string title, const std::u16string& description,
+                        const std::u16string& default_text, uint32_t max_length,
+                        std::u16string* out_text) {
+  std::lock_guard<std::mutex> lock(g_ps4_ime_lock);
+  static bool s_initialized = false;
+  if (!s_initialized) {
+    int32_t r1 = sceSysmoduleLoadModule(0x0096);  // libSceImeDialog
+    int32_t r2 = sceCommonDialogInitialize();
+    REXKRNL_INFO("PS4 IME: sysmodule {:08X}, common dialog {:08X}", uint32_t(r1), uint32_t(r2));
+    s_initialized = true;
+  }
+  // The dialog's limits: at most 2048 characters of text and 128 of title.
+  max_length = std::clamp<uint32_t>(max_length ? max_length - 1 : 1, 1, 2048);
+  std::vector<char16_t> text(max_length + 1, u'\0');
+  for (size_t i = 0; i < default_text.size() && i < max_length; i++) text[i] = default_text[i];
+  if (title.empty()) title = description;
+  if (title.size() > 127) title.resize(127);
+  std::u16string placeholder = description.size() > 127 ? description.substr(0, 127) : description;
+
+  int32_t user_id = -1;
+  sceUserServiceGetInitialUser(&user_id);
+  Ps4ImeDialogParam param = {};
+  param.user_id = user_id;
+  param.max_text_length = max_length;
+  param.input_text_buffer = text.data();
+  param.posx = 960.0f;
+  param.posy = 540.0f;
+  param.horizontal_alignment = 1;  // center
+  param.vertical_alignment = 1;    // center
+  param.placeholder = placeholder.empty() ? nullptr : placeholder.c_str();
+  param.title = title.empty() ? nullptr : title.c_str();
+  int32_t init = sceImeDialogInit(&param, nullptr);
+  if (init < 0) {
+    REXKRNL_ERROR("PS4 IME: sceImeDialogInit failed {:08X} - using the default text",
+                  uint32_t(init));
+    *out_text = default_text;
+    return true;
+  }
+  REXKRNL_INFO("PS4 IME: keyboard open (max {} characters)", max_length);
+  int32_t status;
+  while ((status = sceImeDialogGetStatus()) == 1) {  // running
+    rex::thread::Sleep(std::chrono::milliseconds(16));
+  }
+  Ps4DialogResult result = {};
+  int32_t got = sceImeDialogGetResult(&result);
+  sceImeDialogTerm();
+  const bool ok = got >= 0 && result.end_status == 0;
+  REXKRNL_INFO("PS4 IME: keyboard closed (status {}, result {:08X}, end {})", status,
+               uint32_t(got), result.end_status);
+  if (!ok) return false;
+  out_text->assign(text.data());
+  return true;
+}
+
+std::u16string Ps4LoadGuestString(const mapped_wstring& s) {
+  if (!s) return {};
+  return rex::memory::load_and_swap<std::u16string>(
+      REX_KERNEL_MEMORY()->TranslateVirtual(s.guest_address()));
+}
+
+}  // namespace
+#endif  // REX_PLATFORM_PS4
+
 u32 XamShowKeyboardUI_entry(u32 user_index, u32 flags, mapped_wstring default_text,
