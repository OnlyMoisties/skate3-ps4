+#if REX_PLATFORM_PS4
+// The console delivers FreeBSD's ucontext, not the Linux one musl's headers describe. Offsets into
+// the ucontext measured on hardware by the Skate 3 platform probe (a store with known registers
+// faulting on a protected page): mcontext begins at +64 in FreeBSD's field order, two Sony
+// branch-record fields follow mc_ownedfp, and the fxsave area starts at +320.
+namespace ps4_uc {
+constexpr size_t kRdi = 72, kRsi = 80, kRdx = 88, kRcx = 96, kR8 = 104, kR9 = 112, kRax = 120,
+                 kRbx = 128, kRbp = 136, kR10 = 144, kR11 = 152, kR12 = 160, kR13 = 168,
+                 kR14 = 176, kR15 = 184, kErr = 216, kRip = 224, kRflags = 240, kRsp = 248,
+                 kXmm0 = 320 + 160;
+// In HostThreadContext::int_registers order: rax rcx rdx rbx rsp rbp rsi rdi r8..r15.
+constexpr size_t kIntRegs[16] = {kRax, kRcx, kRdx, kRbx, kRsp, kRbp, kRsi, kRdi,
+                                 kR8,  kR9,  kR10, kR11, kR12, kR13, kR14, kR15};
+inline uint64_t& Reg(void* uc, size_t offset) {
+  return *reinterpret_cast<uint64_t*>(static_cast<uint8_t*>(uc) + offset);
+}
+}  // namespace ps4_uc
+#endif
+
+#if REX_PLATFORM_PS4
+// Profiler counters (rex/ps4_call_counter.h): every fault signal, and how each was resolved.
+static rex::ps4::CallCounter g_fault_signals("fault: signal");
+static rex::ps4::CallCounter g_fault_first_touch("fault: first touch (backed on demand)");
+static rex::ps4::CallCounter g_fault_handled("fault: handled by a registered handler");
+#endif
+
+static void ExceptionHandlerCallback(int signal_number, siginfo_t* signal_info,
+                                     void* signal_context) {
+#if REX_PLATFORM_PS4
+  g_fault_signals.count.fetch_add(1, std::memory_order_relaxed);
+  // Guest memory is backed on demand (memory_ps4.cpp): a first touch is not an exception.
+  if ((signal_number == SIGSEGV || signal_number == SIGBUS) && signal_info &&
+      rex::memory::ps4::HandleFirstTouch(signal_info->si_addr)) {
+    g_fault_first_touch.count.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  HostThreadContext thread_context;
+  thread_context.rip = ps4_uc::Reg(signal_context, ps4_uc::kRip);
+  thread_context.eflags = uint32_t(ps4_uc::Reg(signal_context, ps4_uc::kRflags));
+  for (size_t i = 0; i < 16; i++) {
+    thread_context.int_registers[i] = ps4_uc::Reg(signal_context, ps4_uc::kIntRegs[i]);
+  }
+  std::memcpy(thread_context.xmm_registers,
+              static_cast<uint8_t*>(signal_context) + ps4_uc::kXmm0,
+              sizeof(thread_context.xmm_registers));
+  Exception ex;
+  switch (signal_number) {
+    case SIGILL:
+      ex.InitializeIllegalInstruction(&thread_context);
+      break;
+    case SIGSEGV:
+    case SIGBUS: {
+      constexpr uint64_t kX86PageFaultErrorCodeWrite = UINT64_C(1) << 1;
+      ex.InitializeAccessViolation(&thread_context,
+                                   reinterpret_cast<uint64_t>(signal_info->si_addr),
+                                   (ps4_uc::Reg(signal_context, ps4_uc::kErr) &
+                                    kX86PageFaultErrorCodeWrite)
+                                       ? Exception::AccessViolationOperation::kWrite
+                                       : Exception::AccessViolationOperation::kRead);
+    } break;
+    default:
+      assert_unhandled_case(signal_number);
+  }
+  for (size_t i = 0; i < rex::countof(handlers_) && handlers_[i].first; ++i) {
+    if (handlers_[i].first(&ex, handlers_[i].second)) {
+      g_fault_handled.count.fetch_add(1, std::memory_order_relaxed);
+      ps4_uc::Reg(signal_context, ps4_uc::kRip) = thread_context.rip;
+      auto& rflags = ps4_uc::Reg(signal_context, ps4_uc::kRflags);
+      rflags = (rflags & ~uint64_t(0xFFFFFFFF)) | thread_context.eflags;
+      uint32_t index;
+      uint16_t ints = ex.modified_int_registers();
+      while (rex::bit_scan_forward(ints, &index)) {
+        ints &= ~(UINT16_C(1) << index);
+        ps4_uc::Reg(signal_context, ps4_uc::kIntRegs[index]) = thread_context.int_registers[index];
+      }
+      uint16_t xmms = ex.modified_xmm_registers();
+      while (rex::bit_scan_forward(xmms, &index)) {
+        xmms &= ~(UINT16_C(1) << index);
+        std::memcpy(static_cast<uint8_t*>(signal_context) + ps4_uc::kXmm0 + index * 16,
+                    &thread_context.xmm_registers[index], sizeof(vec128_t));
+      }
+      return;
+    }
+  }
+  DispatchUnhandledSignal(signal_number, signal_info, signal_context);
+}
+#else  // !REX_PLATFORM_PS4
 static void ExceptionHandlerCallback(int signal_number, siginfo_t* signal_info,
                                      void* signal_context) {
 #if REX_PLATFORM_MAC
@@ -313,6 +405,7 @@ static void ExceptionHandlerCallback(int signal_number, siginfo_t* signal_info,
 
   DispatchUnhandledSignal(signal_number, signal_info, signal_context);
 }
+#endif  // REX_PLATFORM_PS4
 
 void ExceptionHandler::Install(Handler fn, void* data) {
   if (!signal_handlers_installed_) {
@@ -321,6 +414,9 @@ void ExceptionHandler::Install(Handler fn, void* data) {
