@@ -0,0 +1,61 @@
+/**
+ * @file        rex/ui/windowed_app_context_ps4.cpp
+ * @brief       PS4 UI loop: the main thread, woken by posted functions
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/ui/windowed_app_context_ps4.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+
+namespace rex {
+namespace ui {
+
+namespace ps4_stats {
+std::atomic<uint64_t> ui_loop_iterations{0};
+std::atomic<uint64_t> ui_functions_started{0};
+std::atomic<uint64_t> ui_functions_finished{0};
+}  // namespace ps4_stats
+
+void PS4WindowedAppContext::NotifyUILoopOfPendingFunctions() {
+  {
+    std::lock_guard<std::mutex> lock(wake_mutex_);
+    pending_ = true;
+  }
+  wake_.notify_one();
+}
+
+void PS4WindowedAppContext::PlatformQuitFromUIThread() {
+  {
+    std::lock_guard<std::mutex> lock(wake_mutex_);
+    quit_ = true;
+  }
+  wake_.notify_one();
+}
+
+int PS4WindowedAppContext::RunMainLoop() {
+  while (!HasQuitFromUIThread()) {
+    {
+      std::unique_lock<std::mutex> lock(wake_mutex_);
+      // The timeout is a safety net only; every producer notifies.
+      wake_.wait_for(lock, std::chrono::milliseconds(100), [this] { return pending_ || quit_; });
+      pending_ = false;
+      if (quit_) break;
+    }
+    ps4_stats::ui_loop_iterations.fetch_add(1, std::memory_order_relaxed);
+    ps4_stats::ui_functions_started.fetch_add(1, std::memory_order_relaxed);
+    ExecutePendingFunctionsFromUIThread();
+    ps4_stats::ui_functions_finished.fetch_add(1, std::memory_order_relaxed);
+  }
+  if (!HasQuitFromUIThread()) {
+    QuitFromUIThread();
+  }
+  return EXIT_SUCCESS;
+}
+
+}  // namespace ui
+}  // namespace rex
diff --git a/src/ui/windowed_app_main_ps4.cpp b/src/ui/windowed_app_main_ps4.cpp
new file mode 100644
index 0000000..d73670d
--- /dev/null
+++ b/src/ui/windowed_app_main_ps4.cpp
@@ -0,0 +1,651 @@
+/**
+ * @file        rex/ui/windowed_app_main_ps4.cpp
+ * @brief       PS4 entry point for windowed rexglue apps
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * A title launched from the home screen gets no command line, so the arguments a desktop build
+ * takes are assembled here: built-in console defaults first, then one argument per line from
+ * /data/<app>/args.txt (lines starting with # are ignored), so a later line overrides a default.
+ *
+ * main() never returns. Returning from main is reported by the console as CE-34878-0 and looks
+ * exactly like a crash; after the app has shut down this idles until the user closes it.
+ */
+
+#include <fcntl.h>
+#include <pthread.h>
+#include <signal.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <cstring>
+#include <sys/time.h>
+
+#include <algorithm>
+#include <atomic>
+#include <thread>
+#include <unordered_map>
+#include <utility>
+
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <string>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ps4_call_counter.h>
+#include <rex/platform.h>
+#include <rex/ui/windowed_app.h>
+#include <rex/ui/windowed_app_context_ps4.h>
+
+extern "C" {
+int32_t sceUserServiceInitialize(const void* params);
+int32_t sceKernelDebugOutText(int32_t channel, const char* text);
+int32_t sceSystemServiceHideSplashScreen();
+int32_t sceKernelAvailableFlexibleMemorySize(size_t* size);
+void rex_ps4_heap_stats(size_t* direct_bytes, size_t* flexible_bytes, uint32_t* failures,
+                        int32_t* last_error);
+int32_t sceKernelSendNotificationRequest(int32_t device, void* request, size_t size,
+                                         int32_t blocking);
+}
+
+std::string RexPs4ThreadName(pthread_t thread);  // threading_posix.cpp
+
+#ifndef REX_PS4_DATA_DIR
+#define REX_PS4_DATA_DIR "/data/rexglue"
+#endif
+
+namespace {
+
+bool g_debug = false;  // set in main() from <data>/debug.txt
+
+void DebugOut(const std::string& line) {
+  if (!g_debug) return;
+  std::string text = line + "\n";
+  sceKernelDebugOutText(0, text.c_str());
+}
+
+// ---- boot progress and crash notes, readable over FTP without catching the kernel log ----
+
+// Appends one line to <data>/boot.txt and syncs it, so a crash right after still leaves it.
+void BootMark(const char* what) {
+  if (!g_debug) return;
+  DebugOut(std::string("rexglue: boot: ") + what);
+  int fd = open(REX_PS4_DATA_DIR "/boot.txt", O_WRONLY | O_CREAT | O_APPEND, 0666);
+  if (fd < 0) return;
+  write(fd, what, std::strlen(what));
+  write(fd, "\n", 1);
+  fsync(fd);
+  close(fd);
+}
+
+// Async-signal-safe hex formatting into a fixed buffer.
+size_t AppendHex(char* out, size_t pos, const char* label, uint64_t value) {
+  static const char kDigits[] = "0123456789abcdef";
+  while (*label) out[pos++] = *label++;
+  out[pos++] = '0';
+  out[pos++] = 'x';
+  for (int shift = 60; shift >= 0; shift -= 4) out[pos++] = kDigits[(value >> shift) & 0xF];
+  out[pos++] = ' ';
+  return pos;
+}
+
+extern "C" char __text_start[];
+constexpr uint64_t kTextEndGuess = 0x10000000;  // generous: the eboot's text ends well below
+
+// Offsets into the PS4 ucontext, measured on hardware (see exception_handler_posix.cpp).
+constexpr size_t kUcRip = 224, kUcRsp = 248, kUcRbp = 136;
+
+void CrashNote(int sig, siginfo_t* info, void* uc) {
+  if (!g_debug) return;
+  char buf[4096];
+  size_t pos = 0;
+  pos = AppendHex(buf, pos, "signal ", uint64_t(sig));
+  pos = AppendHex(buf, pos, "addr ", info ? uint64_t(info->si_addr) : 0);
+  const auto* ctx = static_cast<const uint8_t*>(uc);
+  uint64_t rip = 0, rsp = 0, rbp = 0;
+  if (ctx) {
+    std::memcpy(&rip, ctx + kUcRip, 8);
+    std::memcpy(&rsp, ctx + kUcRsp, 8);
+    std::memcpy(&rbp, ctx + kUcRbp, 8);
+  }
+  pos = AppendHex(buf, pos, "rip ", rip);
+  pos = AppendHex(buf, pos, "rsp ", rsp);
+  pos = AppendHex(buf, pos, "rbp ", rbp);
+  {
+    // Not async-signal-safe in theory (a mutex); the process is going down either way.
+    const std::string name = RexPs4ThreadName(pthread_self());
+    const char* n = name.empty() ? "(unnamed thread)" : name.c_str();
+    const char* label = "thread ";
+    while (*label && pos < 200) buf[pos++] = *label++;
+    while (*n && pos < 260) buf[pos++] = *n++;
+  }
+  buf[pos++] = '\n';
+  // Stack scan: every word near the top of the stack that points into the eboot's text is a
+  // candidate return address - with frame pointers omitted this is the practical backtrace.
+  const uint64_t text_lo = uint64_t(__text_start);
+  const uint64_t* sp = reinterpret_cast<const uint64_t*>(rsp);
+  int found = 0;
+  for (int i = 0; sp && i < 2048 && found < 48 && pos < sizeof(buf) - 40; i++) {
+    uint64_t v = sp[i];
+    if (v >= text_lo && v < kTextEndGuess) {
+      pos = AppendHex(buf, pos, "ret? ", v);
+      buf[pos++] = '\n';
+      found++;
+    }
+  }
+  int fd = open(REX_PS4_DATA_DIR "/crash.txt", O_WRONLY | O_CREAT | O_TRUNC, 0666);
+  if (fd >= 0) {
+    write(fd, buf, pos);
+    fsync(fd);
+    close(fd);
+  }
+  if (pos >= sizeof(buf)) pos = sizeof(buf) - 1;
+  buf[pos] = 0;
+  sceKernelDebugOutText(0, "rexglue: CRASH - see " REX_PS4_DATA_DIR "/crash.txt\n");
+  sceKernelDebugOutText(0, buf);
+}
+
+void CrashHandler(int sig, siginfo_t* info, void* uc) {
+  static volatile int entered = 0;
+  if (!entered++) CrashNote(sig, info, uc);
+  signal(sig, SIG_DFL);
+  raise(sig);
+}
+
+// Installed before anything else. The runtime later installs its own SIGSEGV/SIGBUS/SIGILL
+// handler and chains faults it does not handle back to this one, so it still sees real crashes.
+void InstallCrashReporter() {
+  static uint8_t altstack[64 * 1024];
+  stack_t ss = {};
+  ss.ss_sp = altstack;
+  ss.ss_size = sizeof(altstack);
+  sigaltstack(&ss, nullptr);
+  struct sigaction sa = {};
+  sa.sa_sigaction = CrashHandler;
+  sa.sa_flags = SA_SIGINFO | SA_ONSTACK;  // FreeBSD values via orbis-compat
+  sigemptyset(&sa.sa_mask);
+  for (int sig : {SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT}) sigaction(sig, &sa, nullptr);
+}
+
+// ---- sampling CPU profiler (env REX_PS4_PROFILE_SECONDS=N, REX_PS4_PROFILE_DELAY=M) ----
+//
+// ITIMER_PROF delivers SIGPROF to whichever thread is consuming CPU every 1 ms of process CPU
+// time; the handler stores that thread's rip. After N seconds the histogram of rips goes to
+// <data>/profile.txt ("count address"), symbolised offline against the unstripped ELF.
+
+constexpr size_t kProfileMaxSamples = 1 << 18;
+uint64_t* g_profile_samples = nullptr;
+uint64_t* g_profile_callers = nullptr;
+uint64_t* g_profile_threads = nullptr;
+std::atomic<size_t> g_profile_count{0};
+
+void ProfileSignal(int, siginfo_t*, void* uc) {
+  if (!uc || !g_profile_samples) return;
+  const size_t i = g_profile_count.fetch_add(1, std::memory_order_relaxed);
+  if (i < kProfileMaxSamples) {
+    uint64_t rip, rsp;
+    std::memcpy(&rip, static_cast<const uint8_t*>(uc) + kUcRip, 8);
+    std::memcpy(&rsp, static_cast<const uint8_t*>(uc) + kUcRsp, 8);
+    g_profile_samples[i] = rip;
+    // The nearest return address into the eboot's text above the stack pointer: for a sample in a
+    // system library or libc helper, that is (roughly) which of our functions called it.
+    uint64_t caller = 0;
+    const uint64_t text_lo = uint64_t(__text_start);
+    const uint64_t* sp = reinterpret_cast<const uint64_t*>(rsp);
+    for (int k = 0; sp && k < 24; k++) {
+      const uint64_t v = sp[k];
+      if (v >= text_lo && v < kTextEndGuess) {
+        caller = v;
+        break;
+      }
+    }
+    g_profile_callers[i] = caller;
+    g_profile_threads[i] = uint64_t(pthread_self());
+  }
+}
+
+void StartProfilerIfRequested() {
+  const char* seconds_env = std::getenv("REX_PS4_PROFILE_SECONDS");
+  if (!seconds_env) return;
+  const int seconds = std::atoi(seconds_env);
+  const char* delay_env = std::getenv("REX_PS4_PROFILE_DELAY");
+  const int delay = delay_env ? std::atoi(delay_env) : 20;
+  if (seconds <= 0) return;
+  g_profile_samples = new uint64_t[kProfileMaxSamples];
+  g_profile_callers = new uint64_t[kProfileMaxSamples];
+  g_profile_threads = new uint64_t[kProfileMaxSamples];
+  struct sigaction sa = {};
+  sa.sa_sigaction = ProfileSignal;
+  sa.sa_flags = SA_SIGINFO | SA_RESTART;
+  sigemptyset(&sa.sa_mask);
+  sigaction(SIGPROF, &sa, nullptr);
+  std::thread([seconds, delay]() {
+    sleep(unsigned(delay));
+    BootMark("profiler: sampling");
+    for (int window = 1;; window++) {
+    g_profile_count.store(0);
+    itimerval tv = {};
+    tv.it_interval.tv_usec = 1000;
+    tv.it_value.tv_usec = 1000;
+    setitimer(ITIMER_PROF, &tv, nullptr);
+    sleep(unsigned(seconds));
+    itimerval off = {};
+    setitimer(ITIMER_PROF, &off, nullptr);
+    const size_t n = std::min(g_profile_count.load(), kProfileMaxSamples);
+    std::unordered_map<uint64_t, uint32_t> hist;
+    for (size_t i = 0; i < n; i++) hist[g_profile_samples[i]]++;
+    // (rip, caller) pairs, reported as a second section: "C count rip caller".
+    std::unordered_map<uint64_t, uint32_t> pair_index;
+    std::vector<std::pair<uint64_t, uint64_t>> pairs;
+    std::vector<uint32_t> pair_counts;
+    for (size_t i = 0; i < n; i++) {
+      const uint64_t key = g_profile_samples[i] * 0x9E3779B97F4A7C15ull ^ g_profile_callers[i];
+      auto [it, inserted] = pair_index.emplace(key, uint32_t(pairs.size()));
+      if (inserted) {
+        pairs.emplace_back(g_profile_samples[i], g_profile_callers[i]);
+        pair_counts.push_back(0);
+      }
+      pair_counts[it->second]++;
+    }
+    std::vector<std::pair<uint32_t, uint64_t>> sorted;
+    for (auto& [addr, count] : hist) sorted.emplace_back(count, addr);
+    std::sort(sorted.rbegin(), sorted.rend());
+    char path[128];
+    std::snprintf(path, sizeof path, REX_PS4_DATA_DIR "/profile_%d.txt", window);
+    FILE* f = std::fopen(path, "w");
+    if (f) {
+      std::fprintf(f, "# samples %zu over %d s (1 ms of CPU each)\n", n, seconds);
+      for (size_t i = 0; i < sorted.size() && i < 20000; i++) {
+        std::fprintf(f, "%u 0x%llx\n", sorted[i].first, (unsigned long long)sorted[i].second);
+      }
+      // Per thread: "T count name" (1 sample = 1 ms of that thread's CPU), then the top
+      // functions of the busiest threads as "TR count thread-index rip".
+      std::unordered_map<uint64_t, uint32_t> per_thread;
+      for (size_t i = 0; i < n; i++) per_thread[g_profile_threads[i]]++;
+      std::vector<std::pair<uint32_t, uint64_t>> threads_sorted;
+      for (auto& [t, c] : per_thread) threads_sorted.emplace_back(c, t);
+      std::sort(threads_sorted.rbegin(), threads_sorted.rend());
+      for (size_t k = 0; k < threads_sorted.size(); k++) {
+        std::string name = RexPs4ThreadName(pthread_t(threads_sorted[k].second));
+        std::fprintf(f, "T %u %zu %s\n", threads_sorted[k].first, k,
+                     name.empty() ? "(unnamed)" : name.c_str());
+      }
+      for (size_t k = 0; k < threads_sorted.size() && k < 8; k++) {
+        std::unordered_map<uint64_t, uint32_t> rips;
+        for (size_t i = 0; i < n; i++) {
+          if (g_profile_threads[i] == threads_sorted[k].second) rips[g_profile_samples[i]]++;
+        }
+        std::vector<std::pair<uint32_t, uint64_t>> top;
+        for (auto& [r, c] : rips) top.emplace_back(c, r);
+        std::sort(top.rbegin(), top.rend());
+        for (size_t j = 0; j < top.size() && j < 400; j++) {
+          std::fprintf(f, "TR %u %zu 0x%llx\n", top[j].first, k,
+                       (unsigned long long)top[j].second);
+        }
+      }
+      // Kernel export / hook calls during the window: "K count name".
+      for (auto* c = rex::ps4::CallCounters(); c; c = c->next) {
+        const uint64_t now_count = c->count.load(std::memory_order_relaxed);
+        const uint64_t delta = now_count - c->reported;
+        c->reported = now_count;
+        if (delta) std::fprintf(f, "K %llu %s\n", (unsigned long long)delta, c->name);
+      }
+      for (size_t i = 0; i < pairs.size(); i++) {
+        if (pair_counts[i] < 3) continue;
+        std::fprintf(f, "C %u 0x%llx 0x%llx\n", pair_counts[i],
+                     (unsigned long long)pairs[i].first, (unsigned long long)pairs[i].second);
+      }
+      std::fclose(f);
+    }
+    BootMark("profiler: window written");
+    }  // every `seconds` for the rest of the run: profile_1.txt, profile_2.txt, ...
+  }).detach();
+}
+
+// ---- display stall watchdog ----
+//
+// When the UI thread stops finishing paints for 3 s while the app runs, <data>/stall.txt gets the
+// paint/UI-loop counters and SIGXFSZ interrupts the UI thread so its handler can append where it
+// is (rip + stack scan). Repeats every 5 s while stalled (up to 6 notes), so a moving stack
+// (slow work) can be told from a stuck one (deadlock).
+
+pthread_t g_ui_thread;
+uint64_t g_ui_stack_top = 0;  // an address in main()'s frame: the UI thread never scans past it
+std::atomic<int> g_stall_note_index{0};
+
+void AppendToFile(const char* path, const char* data, size_t size) {
+  int fd = open(path, O_WRONLY | O_CREAT | O_APPEND, 0666);
+  if (fd < 0) return;
+  write(fd, data, size);
+  fsync(fd);
+  close(fd);
+}
+
+void StallSignal(int, siginfo_t*, void* uc) {
+  char buf[4096];
+  size_t pos = 0;
+  pos = AppendHex(buf, pos, "ui-thread note ", uint64_t(g_stall_note_index.load()));
+  const auto* ctx = static_cast<const uint8_t*>(uc);
+  uint64_t rip = 0, rsp = 0;
+  if (ctx) {
+    std::memcpy(&rip, ctx + kUcRip, 8);
+    std::memcpy(&rsp, ctx + kUcRsp, 8);
+  }
+  pos = AppendHex(buf, pos, "rip ", rip);
+  pos = AppendHex(buf, pos, "rsp ", rsp);
+  buf[pos++] = '\n';
+  const uint64_t text_lo = uint64_t(__text_start);
+  const uint64_t* sp = reinterpret_cast<const uint64_t*>(rsp);
+  int found = 0;
+  for (int i = 0; sp && i < 4096 && found < 64 && pos < sizeof(buf) - 40 &&
+                  uint64_t(sp + i) < g_ui_stack_top;
+       i++) {
+    uint64_t v = sp[i];
+    if (v >= text_lo && v < kTextEndGuess) {
+      pos = AppendHex(buf, pos, "ret? ", v);
+      buf[pos++] = '\n';
+      found++;
+    }
+  }
+  AppendToFile(REX_PS4_DATA_DIR "/stall.txt", buf, pos);
+}
