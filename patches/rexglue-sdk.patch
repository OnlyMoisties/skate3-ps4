diff --git a/src/core/memory_ps4.cpp b/src/core/memory_ps4.cpp
new file mode 100644
index 0000000..03d7ad5
--- /dev/null
+++ b/src/core/memory_ps4.cpp
@@ -0,0 +1,379 @@
+/**
+ * @file        rex/core/memory_ps4.cpp
+ * @brief       PS4 backend for rex::memory (host pages, guest view aliasing)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * WHY NOT memory_posix.cpp. On Linux the guest's 4.5 GB "file" is one shm object whose pages the
+ * kernel allocates on first touch, mapped at every guest view that aliases it. The console has
+ * shm_open and MAP_SHARED works (the platform probe measured it), but shm is backed by FLEXIBLE
+ * memory and a title gets ~400 MB of that - the guest needs more. What the console has plenty of is
+ * DIRECT memory (4.6 GB here), and direct memory can be mapped at several addresses at once (the
+ * probe mapped one block at all five physical views). But it is allocated up front, and 4.5 GB of it
+ * would not leave RADV its 1 GB arena.
+ *
+ * SO THE "FILE" IS A LOGICAL OFFSET SPACE, BACKED IN CHUNKS ON DEMAND. MapFileView only reserves
+ * the view's address range and records (view base, length, file offset). The first commit of a
+ * range - or the first touch, through HandleFirstTouch from the fault handler - allocates a 1 MB
+ * chunk of direct memory for each untouched chunk of the file and maps it at EVERY view covering
+ * that file offset, so aliases stay coherent exactly as with shm. Chunks are never returned; a
+ * decommit only drops access, which is also all MADV_DONTNEED does to a shared mapping on Linux.
+ *
+ * Measured on hardware (Skate 3 probe, 2026-09-29) and relied on here:
+ *   - sceKernelReserveVirtualRange lengths must be whole 16 KB pages (else 0x80020016)
+ *   - direct memory maps at several fixed addresses, and a 4 KB-shifted address is refused - the
+ *     0xE0000000 view's +0x1000 therefore lives in address translation (REX_PHYS_HOST_OFFSET)
+ *   - mprotect on one view leaves the other views of the same pages writable
+ */
+
+#include <rex/platform.h>
+static_assert(REX_PLATFORM_PS4, "This file is PS4-only");
+
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+#include <mutex>
+
+#include <rex/ps4_call_counter.h>
+#include <vector>
+
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <rex/assert.h>
+#include <rex/memory/ps4_backing.h>
+#include <rex/memory/utils.h>
+
+extern "C" {
+int32_t sceKernelReserveVirtualRange(void** addr, size_t len, int32_t flags, size_t align);
+size_t sceKernelGetDirectMemorySize(void);
+int32_t sceKernelAllocateDirectMemory(off_t start, off_t end, size_t len, size_t align, int32_t type,
+                                      off_t* phys_out);
+int32_t sceKernelMapDirectMemory(void** addr, size_t len, int32_t prot, int32_t flags, off_t phys,
+                                 size_t align);
+int32_t sceKernelMprotect(const void* addr, size_t len, int32_t prot);
+int32_t sceKernelMunmap(void* addr, size_t len);
+int32_t sceKernelQueryMemoryProtection(void* addr, void** start, void** end, int32_t* prot);
+}
+
+namespace rex {
+namespace memory {
+
+namespace {
+
+constexpr size_t kHostPage = 16 * 1024;           // the console's page
+constexpr size_t kChunk = 1024 * 1024;            // direct-memory backing granule
+constexpr int32_t kSceMapFixed = 0x10;            // MAP_FIXED
+constexpr int32_t kSceMapNoOverwrite = 0x80;      // fail rather than replace an existing mapping
+constexpr int32_t kSceWbOnion = 0;                // SCE_KERNEL_WB_ONION: CPU-cached, GPU-coherent
+constexpr int32_t kSceProtCpuRW = 0x3;            // CPU read | CPU write
+constexpr int32_t kSceProtCpuR = 0x1;
+
+struct View {
+  uint8_t* base;
+  size_t length;
+  size_t file_offset;
+};
+
+struct Backing {
+  bool in_use = false;
+  size_t length = 0;
+  std::vector<off_t> chunk_phys;  // -1 = not yet backed
+  std::vector<View> views;
+};
+
+std::mutex g_lock;
+std::vector<Backing> g_backings;
+
+uintptr_t AlignDown(uintptr_t v, size_t a) { return v & ~uintptr_t(a - 1); }
+uintptr_t AlignUp(uintptr_t v, size_t a) { return (v + a - 1) & ~uintptr_t(a - 1); }
+
+int32_t ToSceProt(PageAccess access) {
+  switch (access) {
+    case PageAccess::kNoAccess:
+      return 0;
+    case PageAccess::kReadOnly:
+    case PageAccess::kExecuteReadOnly:  // guest code is recompiled; guest pages never execute
+      return kSceProtCpuR;
+    case PageAccess::kReadWrite:
+    case PageAccess::kExecuteReadWrite:
+      return kSceProtCpuRW;
+    default:
+      return 0;
+  }
+}
+
+int ToPosixProt(PageAccess access) {
+  switch (access) {
+    case PageAccess::kNoAccess:
+      return PROT_NONE;
+    case PageAccess::kReadOnly:
+    case PageAccess::kExecuteReadOnly:
+      return PROT_READ;
+    case PageAccess::kReadWrite:
+    case PageAccess::kExecuteReadWrite:
+      return PROT_READ | PROT_WRITE;
+    default:
+      return PROT_NONE;
+  }
+}
+
+// Finds the view holding `address`. Caller holds g_lock.
+bool FindView(uintptr_t address, Backing** out_backing, const View** out_view) {
+  for (auto& b : g_backings) {
+    if (!b.in_use) continue;
+    for (const auto& v : b.views) {
+      const auto base = reinterpret_cast<uintptr_t>(v.base);
+      if (address >= base && address < base + v.length) {
+        *out_backing = &b;
+        *out_view = &v;
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+// Backs file chunk `index` with direct memory and maps it at every view covering it. Caller holds
+// g_lock. Returns false only if the console refused the memory, which is fatal for the guest.
+bool BackChunk(Backing& b, size_t index) {
+  if (b.chunk_phys[index] >= 0) return true;
+  const size_t file_begin = index * kChunk;
+  const size_t length = std::min(kChunk, b.length - file_begin);
+  const size_t alloc_len = AlignUp(length, kHostPage);
+  off_t phys = -1;
+  int32_t r = sceKernelAllocateDirectMemory(0, off_t(sceKernelGetDirectMemorySize()), alloc_len,
+                                            64 * 1024, kSceWbOnion, &phys);
+  if (r != 0) {
+    return false;
+  }
+  bool zeroed = false;
+  for (const auto& v : b.views) {
+    if (file_begin + length <= v.file_offset || file_begin >= v.file_offset + v.length) continue;
+    // The part of this chunk the view shows. Views start on chunk boundaries of the file, so a
+    // chunk is either wholly inside a view or clipped only by the view's end.
+    const size_t in_view_begin = std::max(file_begin, v.file_offset);
+    const size_t in_view_end = std::min(file_begin + length, v.file_offset + v.length);
+    void* addr = v.base + (in_view_begin - v.file_offset);
+    const size_t map_len = AlignUp(in_view_end - in_view_begin, kHostPage);
+    r = sceKernelMapDirectMemory(&addr, map_len, kSceProtCpuRW, kSceMapFixed,
+                                 phys + off_t(in_view_begin - file_begin), 0);
+    if (r != 0) {
+      return false;
+    }
+    if (!zeroed) {
+      std::memset(addr, 0, map_len);  // guests expect committed memory to read as zero
+      zeroed = true;
+    }
+  }
+  b.chunk_phys[index] = phys;
+  return true;
+}
+
+// Ensures [address, address+length) is backed if it lies in a view. Returns false if it lies in a
+// view and backing failed; true otherwise (including "not a view address"). Caller holds g_lock.
+bool EnsureBackedLocked(uintptr_t address, size_t length, bool* in_view) {
+  Backing* b = nullptr;
+  const View* v = nullptr;
+  *in_view = FindView(address, &b, &v);
+  if (!*in_view) return true;
+  const auto view_base = reinterpret_cast<uintptr_t>(v->base);
+  const uintptr_t end = std::min(address + std::max<size_t>(length, 1), view_base + v->length);
+  const size_t file_begin = v->file_offset + (address - view_base);
+  const size_t file_end = v->file_offset + (end - view_base);
+  for (size_t i = file_begin / kChunk; i <= (file_end - 1) / kChunk; i++) {
+    if (!BackChunk(*b, i)) return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+namespace ps4 {
+
+bool HandleFirstTouch(void* fault_address) {
+  std::lock_guard<std::mutex> lock(g_lock);
+  Backing* b = nullptr;
+  const View* v = nullptr;
+  const auto address = reinterpret_cast<uintptr_t>(fault_address);
+  if (!FindView(address, &b, &v)) return false;
+  const size_t index = (v->file_offset + (address - reinterpret_cast<uintptr_t>(v->base))) / kChunk;
+  if (b->chunk_phys[index] >= 0) {
+    return false;  // already backed: a real protection fault, not first touch
+  }
+  return BackChunk(*b, index);
+}
+
+}  // namespace ps4
+
+size_t page_size() {
+  return kHostPage;
+}
+size_t allocation_granularity() {
+  return kHostPage;
+}
+
+void* AllocFixed(void* base_address, size_t length, AllocationType allocation_type,
+                 PageAccess access) {
+  if (base_address) {
+    auto begin = AlignDown(reinterpret_cast<uintptr_t>(base_address), kHostPage);
+    auto end = AlignUp(reinterpret_cast<uintptr_t>(base_address) + length, kHostPage);
+    bool in_view = false;
+    std::lock_guard<std::mutex> lock(g_lock);
+    if (allocation_type != AllocationType::kReserve) {
+      if (!EnsureBackedLocked(begin, end - begin, &in_view)) return nullptr;
+    } else {
+      Backing* b;
+      const View* v;
+      in_view = FindView(begin, &b, &v);
+    }
+    if (in_view) {
+      // Inside a guest view: the address space is already ours. Reserve is a no-op (the view
+      // stays accessible, as it does on Linux); commit sets the requested access.
+      if (allocation_type != AllocationType::kReserve &&
+          sceKernelMprotect(reinterpret_cast<void*>(begin), end - begin, ToSceProt(access)) != 0) {
+        return nullptr;
+      }
+      return base_address;
+    }
+  }
+  // Ordinary host memory (flexible memory - keep it small).
+  const int prot = allocation_type == AllocationType::kReserve ? PROT_NONE : ToPosixProt(access);
+  int flags = MAP_PRIVATE | MAP_ANON;
+  if (base_address) flags |= MAP_FIXED;
+  void* result = mmap(base_address, length, prot, flags, -1, 0);
+  return result == MAP_FAILED ? nullptr : result;
+}
+
+bool DeallocFixed(void* base_address, size_t length, DeallocationType deallocation_type) {
+  auto begin = AlignDown(reinterpret_cast<uintptr_t>(base_address), kHostPage);
+  auto end = AlignUp(reinterpret_cast<uintptr_t>(base_address) + length, kHostPage);
+  {
+    std::lock_guard<std::mutex> lock(g_lock);
+    Backing* b;
+    const View* v;
+    if (FindView(begin, &b, &v)) {
+      // Guest view: backing stays (its aliases may still be live); only access is dropped.
+      return sceKernelMprotect(reinterpret_cast<void*>(begin), end - begin, 0) == 0;
+    }
+  }
+  if (deallocation_type == DeallocationType::kDecommit) {
+    if (mprotect(reinterpret_cast<void*>(begin), end - begin, PROT_NONE) != 0) return false;
+    (void)madvise(reinterpret_cast<void*>(begin), end - begin, MADV_DONTNEED);
+    return true;
+  }
+  return munmap(base_address, length) == 0;
+}
+
+rex::ps4::CallCounter g_protect_calls("memory: Protect (sceKernelMprotect)");
+rex::ps4::CallCounter g_query_protect_calls("memory: QueryProtect");
+
+bool Protect(void* base_address, size_t length, PageAccess access, PageAccess* out_old_access) {
+  g_protect_calls.count.fetch_add(1, std::memory_order_relaxed);
+  if (out_old_access) {
+    size_t query_length = 0;
+    *out_old_access = PageAccess::kNoAccess;
+    QueryProtect(base_address, query_length, *out_old_access);
+  }
+  auto begin = AlignDown(reinterpret_cast<uintptr_t>(base_address), kHostPage);
+  auto end = AlignUp(reinterpret_cast<uintptr_t>(base_address) + length, kHostPage);
+  {
+    // A protection change on guest memory needs the pages to exist first: protecting a reserved,
+    // unmapped range fails, and write-watch protects ranges the guest has not touched yet.
+    std::lock_guard<std::mutex> lock(g_lock);
+    bool in_view = false;
+    if (!EnsureBackedLocked(begin, end - begin, &in_view)) return false;
+  }
+  return sceKernelMprotect(reinterpret_cast<void*>(begin), end - begin, ToSceProt(access)) == 0;
+}
+
+bool QueryProtect(void* base_address, size_t& length, PageAccess& access_out) {
+  g_query_protect_calls.count.fetch_add(1, std::memory_order_relaxed);
+  access_out = PageAccess::kNoAccess;
+  length = 0;
+  void* start = nullptr;
+  void* end = nullptr;
+  int32_t prot = 0;
+  if (sceKernelQueryMemoryProtection(base_address, &start, &end, &prot) != 0) {
+    return false;
+  }
+  length = reinterpret_cast<uintptr_t>(end) - reinterpret_cast<uintptr_t>(base_address);
+  if (prot & 0x2) {
+    access_out = PageAccess::kReadWrite;
+  } else if (prot & 0x1) {
+    access_out = PageAccess::kReadOnly;
+  }
+  return true;
+}
+
+FileMappingHandle CreateFileMappingHandle(const std::filesystem::path& path, size_t length,
+                                          PageAccess access, bool commit) {
+  (void)path;
+  (void)access;
+  (void)commit;
+  std::lock_guard<std::mutex> lock(g_lock);
+  size_t index = 0;
+  while (index < g_backings.size() && g_backings[index].in_use) index++;
+  if (index == g_backings.size()) g_backings.emplace_back();
+  Backing& b = g_backings[index];
+  b.in_use = true;
+  b.length = length;
+  b.chunk_phys.assign((length + kChunk - 1) / kChunk, off_t(-1));
+  b.views.clear();
+  return static_cast<FileMappingHandle>(index);
+}
+
+void CloseFileMappingHandle(FileMappingHandle handle, const std::filesystem::path& path) {
+  (void)path;
+  std::lock_guard<std::mutex> lock(g_lock);
+  if (handle < 0 || size_t(handle) >= g_backings.size()) return;
+  // Direct memory is released with the process; the runtime only closes this at shutdown.
+  g_backings[size_t(handle)] = Backing{};
+}
+
+void* MapFileView(FileMappingHandle handle, void* base_address, size_t length, PageAccess access,
+                  size_t file_offset) {
+  (void)access;
+  if (!base_address || file_offset % kHostPage != 0) {
+    return nullptr;  // xmemory.cpp always places views; anywhere-mapping is not needed here
+  }
+  std::lock_guard<std::mutex> lock(g_lock);
+  if (handle < 0 || size_t(handle) >= g_backings.size() || !g_backings[size_t(handle)].in_use) {
+    return nullptr;
+  }
+  Backing& b = g_backings[size_t(handle)];
+  void* addr = base_address;
+  const size_t reserve_len = AlignUp(length, kHostPage);
+  if (sceKernelReserveVirtualRange(&addr, reserve_len, kSceMapFixed | kSceMapNoOverwrite, 0) != 0 ||
+      addr != base_address) {
+    return nullptr;
+  }
+  b.views.push_back(View{static_cast<uint8_t*>(base_address), length, file_offset});
+  // Chunks backed before this view existed (a later MapViews attempt) must appear here too.
+  for (size_t i = file_offset / kChunk; i * kChunk < file_offset + length && i < b.chunk_phys.size();
+       i++) {
+    if (b.chunk_phys[i] < 0) continue;
+    const size_t chunk_begin = i * kChunk;
+    const size_t in_begin = std::max(chunk_begin, file_offset);
+    const size_t in_end = std::min(chunk_begin + kChunk, file_offset + length);
+    void* at = static_cast<uint8_t*>(base_address) + (in_begin - file_offset);
+    sceKernelMapDirectMemory(&at, AlignUp(in_end - in_begin, kHostPage), kSceProtCpuRW,
+                             kSceMapFixed, b.chunk_phys[i] + off_t(in_begin - chunk_begin), 0);
+  }
+  return base_address;
+}
+
+bool UnmapFileView(FileMappingHandle handle, void* base_address, size_t length) {
+  std::lock_guard<std::mutex> lock(g_lock);
+  if (handle >= 0 && size_t(handle) < g_backings.size()) {
+    auto& views = g_backings[size_t(handle)].views;
+    views.erase(std::remove_if(views.begin(), views.end(),
+                               [&](const View& v) { return v.base == base_address; }),
+                views.end());
+  }
+  return sceKernelMunmap(base_address, AlignUp(length, kHostPage)) == 0;
+}
+
+}  // namespace memory
+}  // namespace rex
