diff --git a/src/core/dynlib_ps4.cpp b/src/core/dynlib_ps4.cpp
new file mode 100644
index 0000000..b526e4d
--- /dev/null
+++ b/src/core/dynlib_ps4.cpp
@@ -0,0 +1,78 @@
+/**
+ * @file        rex/core/dynlib_ps4.cpp
+ * @brief       PS4 backend for rex::platform::DynamicLibrary
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * The eboot is statically linked and a homebrew title cannot dlopen arbitrary libraries, so there
+ * is nothing to load. One "library" is still asked for by name: the Vulkan loader. On the console
+ * the Vulkan C ABI is ps4-vkloader over the statically linked RADV (orbis-sdk bundle), so a request
+ * for the loader is answered from those symbols and every other load fails, which each caller
+ * already treats as "not available" (RenderDoc, SPIRV-Tools validation).
+ */
+
+#include <rex/platform.h>
+#include <rex/platform/dynlib.h>
+
+#include <cstring>
+#include <string>
+
+static_assert(REX_PLATFORM_PS4, "This file is PS4-only");
+
+// ps4-vkloader (orbis-compat/vkloader) defines these as ordinary C functions.
+extern "C" void* vkGetInstanceProcAddr(void* instance, const char* name);
+extern "C" void vkDestroyInstance(void* instance, const void* allocator);
+
+namespace rex::platform {
+
+namespace {
+// A non-null handle for the one library that "loads".
+char kStaticVulkanLoader;
+}  // namespace
+
+DynamicLibrary::~DynamicLibrary() {
+  Close();
+}
+
+DynamicLibrary::DynamicLibrary(DynamicLibrary&& other) noexcept : handle_(other.handle_) {
+  other.handle_ = nullptr;
+}
+
+DynamicLibrary& DynamicLibrary::operator=(DynamicLibrary&& other) noexcept {
+  if (this != &other) {
+    Close();
+    handle_ = other.handle_;
+    other.handle_ = nullptr;
+  }
+  return *this;
+}
+
+bool DynamicLibrary::Load(const std::filesystem::path& path) {
+  Close();
+  const std::string name = path.filename().string();
+  if (name.find("vulkan") != std::string::npos) {
+    handle_ = &kStaticVulkanLoader;
+  }
+  return handle_ != nullptr;
+}
+
+void DynamicLibrary::Close() {
+  handle_ = nullptr;
+}
+
+void* DynamicLibrary::GetRawSymbol(const char* name) const {
+  if (handle_ != &kStaticVulkanLoader || !name) {
+    return nullptr;
+  }
+  if (!std::strcmp(name, "vkGetInstanceProcAddr")) {
+    return reinterpret_cast<void*>(&vkGetInstanceProcAddr);
+  }
+  if (!std::strcmp(name, "vkDestroyInstance")) {
+    return reinterpret_cast<void*>(&vkDestroyInstance);
+  }
+  // Anything else goes through vkGetInstanceProcAddr, as the Vulkan spec intends.
+  return vkGetInstanceProcAddr(nullptr, name);
+}
+
+}  // namespace rex::platform
