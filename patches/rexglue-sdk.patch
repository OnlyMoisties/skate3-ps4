diff --git a/src/input/ps4/ps4_input_driver.cpp b/src/input/ps4/ps4_input_driver.cpp
new file mode 100644
index 0000000..432fd18
--- /dev/null
+++ b/src/input/ps4/ps4_input_driver.cpp
@@ -0,0 +1,277 @@
+/**
+ * @file        rex/input/ps4/ps4_input_driver.cpp
+ * @brief       PS4 controller input (scePad) presented as an Xbox 360 pad
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * One DualShock 4 - the user who started the title - is guest controller 0. Cross/Circle/Square/
+ * Triangle map to A/B/X/Y, OPTIONS to Start and the touch pad click to Back, the way PS4 remasters
+ * of 360 games lay them out.
+ */
+
+#include <rex/input/ps4/ps4_input_driver.h>
+
+#include <cstring>
+
+#include <rex/chrono/clock.h>
+#include <rex/logging.h>
+#include <rex/ui/virtual_key.h>
+
+extern "C" {
+int32_t sceUserServiceGetInitialUser(int32_t* user_id);
+int32_t scePadInit(void);
+int32_t scePadOpen(int32_t user_id, int32_t type, int32_t index, void* param);
+int32_t scePadReadState(int32_t handle, void* data);
+int32_t scePadSetVibration(int32_t handle, const void* param);
+int32_t scePadClose(int32_t handle);
+}
+
+namespace {
+
+// OrbisPadData (orbis/_types/pad.h), only the part read here; the rest is sized generously.
+struct PadData {
+  uint32_t buttons;
+  uint8_t lx, ly, rx, ry;
+  uint8_t l2, r2;
+  uint16_t padding;
+  uint8_t rest[128];
+};
+
+constexpr uint32_t kPadL3 = 0x0002, kPadR3 = 0x0004, kPadOptions = 0x0008, kPadUp = 0x0010,
+                   kPadRight = 0x0020, kPadDown = 0x0040, kPadLeft = 0x0080, kPadL1 = 0x0400,
+                   kPadR1 = 0x0800, kPadTriangle = 0x1000, kPadCircle = 0x2000,
+                   kPadCross = 0x4000, kPadSquare = 0x8000, kPadTouchPad = 0x100000;
+
+int16_t Axis(uint8_t v, bool invert) {
+  int32_t centered = int32_t(v) - 128;  // -128..127
+  int32_t scaled = centered < 0 ? centered * 256 : centered * 32767 / 127;
+  if (invert) scaled = -scaled - 1;
+  if (scaled > 32767) scaled = 32767;
+  if (scaled < -32768) scaled = -32768;
+  return int16_t(scaled);
+}
+
+}  // namespace
+
+namespace rex::input::ps4 {
+
+PS4InputDriver::PS4InputDriver(rex::ui::Window* window, size_t window_z_order)
+    : InputDriver(window, window_z_order) {}
+
+PS4InputDriver::~PS4InputDriver() {
+  if (handle_ >= 0) scePadClose(handle_);
+}
+
+X_STATUS PS4InputDriver::Setup() {
+  scePadInit();
+  int32_t user = -1;
+  if (sceUserServiceGetInitialUser(&user) != 0) {
+    REXLOG_ERROR("PS4InputDriver: no initial user");
+    return X_STATUS_UNSUCCESSFUL;
+  }
+  handle_ = scePadOpen(user, 0 /* standard port */, 0, nullptr);
+  if (handle_ < 0) {
+    REXLOG_ERROR("PS4InputDriver: scePadOpen(user {}) failed: 0x{:08X}", user, uint32_t(handle_));
+    return X_STATUS_UNSUCCESSFUL;
+  }
+  REXLOG_INFO("PS4InputDriver: DualShock 4 open for user {} (handle {})", user, handle_);
+  return X_STATUS_SUCCESS;
+}
+
+X_RESULT PS4InputDriver::GetCapabilities(uint32_t user_index, uint32_t flags,
+                                         X_INPUT_CAPABILITIES* out_caps) {
+  (void)flags;
+  if (user_index != 0 || handle_ < 0) return X_ERROR_DEVICE_NOT_CONNECTED;
+  if (out_caps) {
+    std::memset(out_caps, 0, sizeof(*out_caps));
+    out_caps->type = 0x01;      // XINPUT_DEVTYPE_GAMEPAD
+    out_caps->sub_type = 0x01;  // XINPUT_DEVSUBTYPE_GAMEPAD
+    out_caps->gamepad.buttons = 0xFFFF;
+    out_caps->gamepad.left_trigger = 0xFF;
+    out_caps->gamepad.right_trigger = 0xFF;
+    out_caps->gamepad.thumb_lx = int16_t(0x7FFF);
+    out_caps->gamepad.thumb_ly = int16_t(0x7FFF);
+    out_caps->gamepad.thumb_rx = int16_t(0x7FFF);
+    out_caps->gamepad.thumb_ry = int16_t(0x7FFF);
+    out_caps->vibration.left_motor_speed = 0xFFFF;
+    out_caps->vibration.right_motor_speed = 0xFFFF;
+  }
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT PS4InputDriver::ReadState(uint32_t user_index, X_INPUT_STATE* out_state) {
+  if (user_index != 0 || handle_ < 0) return X_ERROR_DEVICE_NOT_CONNECTED;
+  PadData pad{};
+  if (scePadReadState(handle_, &pad) != 0) return X_ERROR_DEVICE_NOT_CONNECTED;
+
+  uint16_t b = 0;
+  if (pad.buttons & kPadUp) b |= X_INPUT_GAMEPAD_DPAD_UP;
+  if (pad.buttons & kPadDown) b |= X_INPUT_GAMEPAD_DPAD_DOWN;
+  if (pad.buttons & kPadLeft) b |= X_INPUT_GAMEPAD_DPAD_LEFT;
+  if (pad.buttons & kPadRight) b |= X_INPUT_GAMEPAD_DPAD_RIGHT;
+  if (pad.buttons & kPadOptions) b |= X_INPUT_GAMEPAD_START;
+  if (pad.buttons & kPadTouchPad) b |= X_INPUT_GAMEPAD_BACK;
+  if (pad.buttons & kPadL3) b |= X_INPUT_GAMEPAD_LEFT_THUMB;
+  if (pad.buttons & kPadR3) b |= X_INPUT_GAMEPAD_RIGHT_THUMB;
+  if (pad.buttons & kPadL1) b |= X_INPUT_GAMEPAD_LEFT_SHOULDER;
+  if (pad.buttons & kPadR1) b |= X_INPUT_GAMEPAD_RIGHT_SHOULDER;
+  if (pad.buttons & kPadCross) b |= X_INPUT_GAMEPAD_A;
+  if (pad.buttons & kPadCircle) b |= X_INPUT_GAMEPAD_B;
+  if (pad.buttons & kPadSquare) b |= X_INPUT_GAMEPAD_X;
+  if (pad.buttons & kPadTriangle) b |= X_INPUT_GAMEPAD_Y;
+
+  X_INPUT_GAMEPAD g{};
+  g.buttons = b;
+  g.left_trigger = pad.l2;
+  g.right_trigger = pad.r2;
+  g.thumb_lx = Axis(pad.lx, false);
+  g.thumb_ly = Axis(pad.ly, true);  // DS4 Y grows downwards, Xbox Y upwards
+  g.thumb_rx = Axis(pad.rx, false);
+  g.thumb_ry = Axis(pad.ry, true);
+
+  std::lock_guard<std::mutex> lock(lock_);
+  if (std::memcmp(&g, &last_, sizeof(g)) != 0) {
+    last_ = g;
+    packet_number_++;
+  }
+  if (out_state) {
+    out_state->packet_number = packet_number_;
+    out_state->gamepad = g;
+  }
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT PS4InputDriver::GetState(uint32_t user_index, X_INPUT_STATE* out_state) {
+  if (!is_active()) {
+    // Guest input is suppressed (an overlay is open): report a neutral pad, still connected.
+    if (user_index != 0 || handle_ < 0) return X_ERROR_DEVICE_NOT_CONNECTED;
+    if (out_state) std::memset(out_state, 0, sizeof(*out_state));
+    return X_ERROR_SUCCESS;
+  }
+  return ReadState(user_index, out_state);
+}
+
+X_RESULT PS4InputDriver::GetStateUi(uint32_t user_index, X_INPUT_STATE* out_state) {
+  return ReadState(user_index, out_state);
+}
+
+X_RESULT PS4InputDriver::SetState(uint32_t user_index, X_INPUT_VIBRATION* vibration) {
+  if (user_index != 0 || handle_ < 0) return X_ERROR_DEVICE_NOT_CONNECTED;
+  if (vibration) {
+    uint8_t param[2] = {uint8_t(uint16_t(vibration->left_motor_speed) >> 8),
+                        uint8_t(uint16_t(vibration->right_motor_speed) >> 8)};
+    scePadSetVibration(handle_, param);
+  }
+  return X_ERROR_SUCCESS;
+}
+
+uint64_t PS4InputDriver::AnalogToKeyfield(const X_INPUT_GAMEPAD& gamepad) {
+  constexpr int16_t kThumbThreshold = 0x4E00;
+  constexpr uint8_t kTriggerThreshold = 0x1F;
+  uint64_t f = 0;
+  f |= uint64_t(gamepad.left_trigger > kTriggerThreshold) << 16;
+  f |= uint64_t(gamepad.right_trigger > kTriggerThreshold) << 17;
+  for (int stick = 0; stick < 2; stick++) {
+    const int16_t x = stick ? int16_t(gamepad.thumb_rx) : int16_t(gamepad.thumb_lx);
+    const int16_t y = stick ? int16_t(gamepad.thumb_ry) : int16_t(gamepad.thumb_ly);
+    const size_t i = stick ? 8 : 0;
+    uint64_t u = y > kThumbThreshold, d = y < ~kThumbThreshold;
+    uint64_t r = x > kThumbThreshold, l = x < ~kThumbThreshold;
+    if (u && l) { u = l = 0; f |= uint64_t(1) << (22 + i); }
+    if (u && r) { u = r = 0; f |= uint64_t(1) << (23 + i); }
+    if (d && r) { d = r = 0; f |= uint64_t(1) << (24 + i); }
+    if (d && l) { d = l = 0; f |= uint64_t(1) << (25 + i); }
+    f |= u << (18 + i);
+    f |= d << (19 + i);
+    f |= r << (20 + i);
+    f |= l << (21 + i);
+  }
+  return f;
+}
+
+// XInputGetKeystroke. Menus such as Skate 3's career-intro dialog wait for keystrokes rather than
+// polling the pad state, so returning "empty" here left them unanswerable (run 17: the game kept
+// rendering the dialog at 30 fps while A did nothing).
+X_RESULT PS4InputDriver::GetKeystroke(uint32_t user_index, uint32_t flags,
+                                      X_INPUT_KEYSTROKE* out_keystroke) {
+  (void)flags;
+  if (user_index != 0 && user_index != 0xFF) return X_ERROR_DEVICE_NOT_CONNECTED;
+  if (!out_keystroke) return X_ERROR_BAD_ARGUMENTS;
+  if (handle_ < 0) return X_ERROR_DEVICE_NOT_CONNECTED;
+
+  using rex::ui::VirtualKey;
+  static constexpr VirtualKey kVk[34] = {
+      VirtualKey::kXInputPadDpadUp,       VirtualKey::kXInputPadDpadDown,
+      VirtualKey::kXInputPadDpadLeft,     VirtualKey::kXInputPadDpadRight,
+      VirtualKey::kXInputPadStart,        VirtualKey::kXInputPadBack,
+      VirtualKey::kXInputPadLThumbPress,  VirtualKey::kXInputPadRThumbPress,
+      VirtualKey::kXInputPadLShoulder,    VirtualKey::kXInputPadRShoulder,
+      VirtualKey::kNone,                  VirtualKey::kNone,
+      VirtualKey::kXInputPadA,            VirtualKey::kXInputPadB,
+      VirtualKey::kXInputPadX,            VirtualKey::kXInputPadY,
+      VirtualKey::kXInputPadLTrigger,     VirtualKey::kXInputPadRTrigger,
+      VirtualKey::kXInputPadLThumbUp,     VirtualKey::kXInputPadLThumbDown,
+      VirtualKey::kXInputPadLThumbRight,  VirtualKey::kXInputPadLThumbLeft,
+      VirtualKey::kXInputPadLThumbUpLeft, VirtualKey::kXInputPadLThumbUpRight,
+      VirtualKey::kXInputPadLThumbDownRight, VirtualKey::kXInputPadLThumbDownLeft,
+      VirtualKey::kXInputPadRThumbUp,     VirtualKey::kXInputPadRThumbDown,
+      VirtualKey::kXInputPadRThumbRight,  VirtualKey::kXInputPadRThumbLeft,
+      VirtualKey::kXInputPadRThumbUpLeft, VirtualKey::kXInputPadRThumbUpRight,
+      VirtualKey::kXInputPadRThumbDownRight, VirtualKey::kXInputPadRThumbDownLeft,
+  };
+  constexpr uint64_t kRepeatDelayMs = 400;
+  constexpr uint64_t kRepeatRateMs = 100;
+
+  X_INPUT_STATE state{};
+  const bool active = is_active();
+  if (active && ReadState(0, &state) != X_ERROR_SUCCESS) return X_ERROR_DEVICE_NOT_CONNECTED;
+  const uint64_t current =
+      active ? (uint64_t(uint16_t(state.gamepad.buttons)) | AnalogToKeyfield(state.gamepad)) : 0;
+
+  std::lock_guard<std::mutex> lock(lock_);
+  auto fill = [&](VirtualKey vk, uint16_t key_flags) {
+    out_keystroke->virtual_key = uint16_t(vk);
+    out_keystroke->unicode = 0;
+    out_keystroke->user_index = 0;
+    out_keystroke->hid_code = 0;
+    out_keystroke->flags = key_flags;
+  };
+  const uint64_t now = rex::chrono::Clock::QueryGuestUptimeMillis();
+  if (repeat_state_ == RepeatState::Waiting && repeat_time_ + kRepeatDelayMs < now) {
+    repeat_state_ = RepeatState::Repeating;
+  }
+  if (repeat_state_ == RepeatState::Repeating && repeat_time_ + kRepeatRateMs < now) {
+    repeat_time_ = now;
+    fill(kVk[repeat_index_], X_INPUT_KEYSTROKE_KEYDOWN | X_INPUT_KEYSTROKE_REPEAT);
+    return X_ERROR_SUCCESS;
+  }
+  const uint64_t changed = current ^ keystroke_buttons_;
+  if (!changed) return X_ERROR_EMPTY;
+  // Releases first, then presses (so a stick moving from UP-LEFT to LEFT reports the diagonal up
+  // before the new direction down), one event per call.
+  for (int pass = 0; pass < 2; pass++) {
+    for (uint8_t i = 0; i < 34; i++) {
+      const uint64_t bit = uint64_t(1) << i;
+      if (!(changed & bit) || kVk[i] == VirtualKey::kNone) continue;
+      const bool pressed = current & bit;
+      if (pass == 0 && !pressed) {
+        fill(kVk[i], X_INPUT_KEYSTROKE_KEYUP);
+        keystroke_buttons_ &= ~bit;
+        repeat_state_ = RepeatState::Idle;
+        return X_ERROR_SUCCESS;
+      }
+      if (pass == 1 && pressed) {
+        fill(kVk[i], X_INPUT_KEYSTROKE_KEYDOWN);
+        keystroke_buttons_ |= bit;
+        repeat_state_ = RepeatState::Waiting;
+        repeat_index_ = i;
+        repeat_time_ = now;
+        return X_ERROR_SUCCESS;
+      }
+    }
+  }
+  return X_ERROR_EMPTY;
+}
+
+}  // namespace rex::input::ps4
