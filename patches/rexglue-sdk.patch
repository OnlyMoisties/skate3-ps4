diff --git a/include/rex/audio/ps4/ps4_audio_driver.h b/include/rex/audio/ps4/ps4_audio_driver.h
new file mode 100644
index 0000000..be9e3dc
--- /dev/null
+++ b/include/rex/audio/ps4/ps4_audio_driver.h
@@ -0,0 +1,55 @@
+/**
+ * @file        rex/audio/ps4/ps4_audio_driver.h
+ * @brief       PS4 audio driver: one guest voice on one sceAudioOut port
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+#include <queue>
+#include <stack>
+#include <thread>
+
+#include <rex/audio/audio_driver.h>
+#include <rex/thread.h>
+
+namespace rex::audio::ps4 {
+
+// The guest submits 256-sample frames of 6 big-endian float channels (5.1) and is paced by
+// credits: one semaphore release per frame played. sceAudioOutOutput blocks until the previous
+// buffer has been consumed, so a single output thread playing one 256-sample buffer per call runs
+// at exactly the device's rate and releases credits in real time - no separate pacer needed.
+class PS4AudioDriver : public AudioDriver {
+ public:
+  PS4AudioDriver(memory::Memory* memory, rex::thread::Semaphore* semaphore);
+  ~PS4AudioDriver() override;
+
+  bool Initialize();
+  void SubmitFrame(uint32_t frame_ptr) override;
+  void Shutdown();
+
+ private:
+  void OutputThread();
+
+  static constexpr uint32_t kFrequency = 48000;
+  static constexpr uint32_t kGuestChannels = 6;
+  static constexpr uint32_t kChannelSamples = 256;
+  static constexpr uint32_t kGuestFrameSamples = kGuestChannels * kChannelSamples;
+
+  rex::thread::Semaphore* semaphore_ = nullptr;
+  int32_t port_ = -1;
+  std::thread thread_;
+  std::atomic<bool> running_{false};
+
+  std::queue<float*> frames_queued_;
+  std::stack<float*> frames_unused_;
+  std::mutex frames_mutex_;
+};
+
+}  // namespace rex::audio::ps4
