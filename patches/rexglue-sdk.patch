diff --git a/src/core/cxa_thread_atexit_ps4.cpp b/src/core/cxa_thread_atexit_ps4.cpp
new file mode 100644
index 0000000..0cc8569
--- /dev/null
+++ b/src/core/cxa_thread_atexit_ps4.cpp
@@ -0,0 +1,61 @@
+/**
+ * @file        rex/core/cxa_thread_atexit_ps4.cpp
+ * @brief       __cxa_thread_atexit for the PS4 (thread_local objects with destructors)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * The compiler emits a call to __cxa_thread_atexit for every thread_local with a non-trivial
+ * destructor. libc++abi only implements it on Linux/Fuchsia (it forwards to glibc's
+ * __cxa_thread_atexit_impl), so on the console nothing defines it. This is the same pthread-key
+ * scheme as orbis-compat's orbis_thread_atexit.c: a per-thread list run by the key's destructor
+ * when the thread exits, newest registration first.
+ */
+
+#include <rex/platform.h>
+static_assert(REX_PLATFORM_PS4, "This file is PS4-only");
+
+#include <pthread.h>
+#include <cstdlib>
+
+namespace {
+
+struct ThreadDtor {
+  void (*func)(void*);
+  void* obj;
+  ThreadDtor* next;
+};
+
+pthread_key_t g_key;
+pthread_once_t g_once = PTHREAD_ONCE_INIT;
+
+void RunDtors(void* head) {
+  auto* d = static_cast<ThreadDtor*>(head);
+  while (d) {
+    ThreadDtor* next = d->next;
+    d->func(d->obj);
+    std::free(d);
+    d = next;
+  }
+}
+
+void InitKey() {
+  pthread_key_create(&g_key, RunDtors);
+}
+
+}  // namespace
+
+extern "C" int __cxa_thread_atexit(void (*func)(void*), void* obj, void* dso_handle) {
+  (void)dso_handle;
+  if (pthread_once(&g_once, InitKey) != 0) return -1;
+  auto* d = static_cast<ThreadDtor*>(std::malloc(sizeof(ThreadDtor)));
+  if (!d) return -1;
+  d->func = func;
+  d->obj = obj;
+  d->next = static_cast<ThreadDtor*>(pthread_getspecific(g_key));
+  if (pthread_setspecific(g_key, d) != 0) {
+    std::free(d);
+    return -1;
+  }
+  return 0;
+}
