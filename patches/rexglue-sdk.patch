+    auto dump = [&](uint32_t a) {
+      if (a < 0x40000000u || a >= 0xC0000000u) return;
+      for (uint32_t x : seen) if (x == a) return;
+      if (seen.size() >= 24) return;
+      seen.push_back(a);
+      for (uint32_t off = 0; off < 64; off += 32) {
+        const uint8_t* w = base + a + off;
+        auto be = [&](int i) {
+          return uint32_t(w[i * 4]) << 24 | uint32_t(w[i * 4 + 1]) << 16 |
+                 uint32_t(w[i * 4 + 2]) << 8 | uint32_t(w[i * 4 + 3]);
+        };
