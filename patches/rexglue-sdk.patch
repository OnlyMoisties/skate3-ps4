new file mode 100644
index 0000000..1f528ae
--- /dev/null
+++ b/src/ui/window_ps4.cpp
@@ -0,0 +1,111 @@
+/**
+ * @file        rex/ui/window_ps4.cpp
+ * @brief       PS4 window: the whole display, always fullscreen
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/ui/window_ps4.h>
+
+#include <atomic>
+#include <mutex>
+
+#include <rex/logging.h>
+#include <rex/ui/surface_ps4.h>
+#include <rex/ui/windowed_app_context.h>
+
+namespace rex {
+namespace ui {
+
+// Read by the stall watchdog in windowed_app_main_ps4.cpp.
+namespace ps4_stats {
+std::atomic<uint64_t> paint_requests{0};
+std::atomic<uint64_t> paint_coalesced{0};
+std::atomic<uint64_t> paint_started{0};
+std::atomic<uint64_t> paint_finished{0};
+}  // namespace ps4_stats
+
+namespace {
+// Paint requests arrive from any thread and run later on the UI thread; a request that outlives
+// its window must find it gone rather than touch freed memory.
+std::mutex g_live_lock;
+PS4Window* g_live_window = nullptr;
+}  // namespace
+
+std::unique_ptr<Window> Window::Create(WindowedAppContext& app_context,
+                                       const std::string_view title, uint32_t desired_logical_width,
+                                       uint32_t desired_logical_height) {
+  return std::make_unique<PS4Window>(app_context, title, desired_logical_width,
+                                     desired_logical_height);
+}
+
+PS4Window::PS4Window(WindowedAppContext& app_context, const std::string_view title,
+                     uint32_t desired_logical_width, uint32_t desired_logical_height)
+    : Window(app_context, title, desired_logical_width, desired_logical_height) {
+  std::lock_guard<std::mutex> lock(g_live_lock);
+  g_live_window = this;
+}
+
+PS4Window::~PS4Window() {
+  {
+    std::lock_guard<std::mutex> lock(g_live_lock);
+    if (g_live_window == this) g_live_window = nullptr;
+  }
+  EnterDestructor();
+}
+
+bool PS4Window::OpenImpl() {
+  WindowDestructionReceiver destruction_receiver(this);
+  OnActualSizeUpdate(kDisplayWidth, kDisplayHeight, destruction_receiver);
+  if (destruction_receiver.IsWindowDestroyedOrClosed()) {
+    return true;
+  }
+  OnFocusUpdate(true, destruction_receiver);
+  return true;
+}
+
+void PS4Window::RequestCloseImpl() {
+  WindowDestructionReceiver destruction_receiver(this);
+  OnBeforeClose(destruction_receiver);
+  if (!destruction_receiver.IsWindowDestroyed()) {
+    OnAfterClose();
+  }
+}
+
+std::unique_ptr<Surface> PS4Window::CreateSurfaceImpl(Surface::TypeFlags allowed_types) {
+  if (!(allowed_types & Surface::kTypeFlag_PS4Display)) {
+    REXLOG_ERROR("PS4Window: the presenter cannot use the PS4 display surface");
+    return nullptr;
+  }
+  return std::make_unique<PS4DisplaySurface>(kDisplayWidth, kDisplayHeight);
+}
+
+void PS4Window::RequestPaintImpl() {
+  ps4_stats::paint_requests.fetch_add(1, std::memory_order_relaxed);
+  bool expected = false;
+  if (!paint_queued_.compare_exchange_strong(expected, true, std::memory_order_acq_rel)) {
+    ps4_stats::paint_coalesced.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  PS4Window* self = this;
+  app_context().CallInUIThread([self]() {
+    {
+      std::lock_guard<std::mutex> lock(g_live_lock);
+      if (g_live_window != self) return;
+    }
+    self->paint_queued_.store(false, std::memory_order_release);
+    ps4_stats::paint_started.fetch_add(1, std::memory_order_relaxed);
+    self->OnPaint();
+    ps4_stats::paint_finished.fetch_add(1, std::memory_order_relaxed);
+  });
+}
+
+std::unique_ptr<ui::MenuItem> MenuItem::Create(Type type, const std::string& text,
+                                               const std::string& hotkey,
+                                               std::function<void()> callback) {
+  return std::make_unique<PS4MenuItem>(type, text, hotkey, std::move(callback));
+}
+
+}  // namespace ui
+}  // namespace rex
