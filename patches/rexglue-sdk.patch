+/**
+ * @file        core/fma_ps4.cpp
+ * @brief       Fast fma/fmaf for the PS4's Jaguar cores, which have no FMA instruction
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * Recompiled PowerPC fmadd/fmsub/fnmadd call std::fma. Without hardware FMA that resolves to the
+ * C library's exact software fma, which cost ~13% of all CPU time in Skate 3 gameplay (fma plus
+ * its normalize/scalbn helpers). These definitions replace it for the whole link: a multiply
+ * then an add, as Xenia does on hosts without FMA. Results can differ from a fused operation in
+ * the last bit only. fmaf is computed in double, where the float product is exact, so it rounds
+ * once at the add and once to float.
+ */
+
+extern "C" {
+
+double fma(double x, double y, double z) {
+  return x * y + z;  // built with -fno-builtin-fma, so this stays a multiply and an add
+}
+
+float fmaf(float x, float y, float z) {
+  return float(double(x) * double(y) + double(z));
+}
+
+}  // extern "C"
