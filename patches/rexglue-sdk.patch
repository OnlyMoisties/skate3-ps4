new file mode 100644
index 0000000..ee71975
--- /dev/null
+++ b/src/audio/ps4/ps4_audio_driver.cpp
@@ -0,0 +1,127 @@
+/**
+ * @file        rex/audio/ps4/ps4_audio_driver.cpp
+ * @brief       PS4 audio driver: one guest voice on one sceAudioOut port
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/audio/ps4/ps4_audio_driver.h>
+
+#include <cstring>
+
+#include <rex/assert.h>
+#include <rex/audio/conversion.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/memory.h>
+#include <rex/system/xmemory.h>
+
+REXCVAR_DECLARE(bool, audio_mute);
+REXCVAR_DEFINE_BOOL(audio_mute, false, "Audio", "Mute audio output");
+
+extern "C" {
+int32_t sceAudioOutInit(void);
+int32_t sceAudioOutOpen(int32_t user_id, int32_t port_type, int32_t index, uint32_t length,
+                        uint32_t sample_rate, uint32_t param_type);
+int32_t sceAudioOutOutput(int32_t handle, const void* data);
+int32_t sceAudioOutClose(int32_t handle);
+}
+
+namespace {
+constexpr int32_t kUserIdSystem = 0xFF;      // ORBIS_USER_SERVICE_USER_ID_SYSTEM
+constexpr int32_t kPortMain = 0;             // ORBIS_AUDIO_OUT_PORT_TYPE_MAIN
+constexpr uint32_t kFormatFloatStereo = 4;   // ORBIS_AUDIO_OUT_PARAM_FORMAT_FLOAT_STEREO
+}  // namespace
+
+namespace rex::audio::ps4 {
+
+PS4AudioDriver::PS4AudioDriver(memory::Memory* memory, rex::thread::Semaphore* semaphore)
+    : AudioDriver(memory), semaphore_(semaphore) {}
+
+PS4AudioDriver::~PS4AudioDriver() {
+  assert_true(frames_queued_.empty());
+  assert_true(frames_unused_.empty());
+}
+
+bool PS4AudioDriver::Initialize() {
+  // sceAudioOutInit returns "already initialised" for every driver after the first.
+  sceAudioOutInit();
+  port_ = sceAudioOutOpen(kUserIdSystem, kPortMain, 0, kChannelSamples, kFrequency,
+                          kFormatFloatStereo);
+  if (port_ < 0) {
+    REXAPU_ERROR("sceAudioOutOpen failed: 0x{:08X}", uint32_t(port_));
+    return false;
+  }
+  SetAutoDeviceSampleFrames(int32_t(kChannelSamples));
+  running_ = true;
+  thread_ = std::thread(&PS4AudioDriver::OutputThread, this);
+  return true;
+}
+
+void PS4AudioDriver::SubmitFrame(uint32_t frame_ptr) {
+  const auto input_frame = memory_->TranslateVirtual<float*>(frame_ptr);
+  float* output_frame;
+  {
+    std::lock_guard<std::mutex> guard(frames_mutex_);
+    if (frames_unused_.empty()) {
+      output_frame = new float[kGuestFrameSamples];
+    } else {
+      output_frame = frames_unused_.top();
+      frames_unused_.pop();
+    }
+  }
+  std::memcpy(output_frame, input_frame, kGuestFrameSamples * sizeof(float));
+  std::lock_guard<std::mutex> guard(frames_mutex_);
+  frames_queued_.push(output_frame);
+}
+
+void PS4AudioDriver::OutputThread() {
+  alignas(32) float out[kChannelSamples * 2];
+  while (running_) {
+    float* frame = nullptr;
+    {
+      std::lock_guard<std::mutex> guard(frames_mutex_);
+      if (!frames_queued_.empty()) {
+        frame = frames_queued_.front();
+        frames_queued_.pop();
+      }
+    }
+    if (frame && !REXCVAR_GET(audio_mute)) {
+      conversion::sequential_6_BE_to_interleaved_2_LE(out, frame, kChannelSamples);
+    } else {
+      std::memset(out, 0, sizeof(out));
+    }
+    // Blocks until the previous buffer has been handed to the hardware: this is the clock.
+    sceAudioOutOutput(port_, out);
+    if (frame) {
+      {
+        std::lock_guard<std::mutex> guard(frames_mutex_);
+        frames_unused_.push(frame);
+      }
+      semaphore_->Release(1, nullptr);
+    }
+  }
+}
+
+void PS4AudioDriver::Shutdown() {
+  if (running_.exchange(false) && thread_.joinable()) {
+    thread_.join();
+  }
+  if (port_ >= 0) {
+    sceAudioOutOutput(port_, nullptr);  // drain
+    sceAudioOutClose(port_);
+    port_ = -1;
+  }
+  std::lock_guard<std::mutex> guard(frames_mutex_);
+  while (!frames_unused_.empty()) {
+    delete[] frames_unused_.top();
+    frames_unused_.pop();
+  }
+  while (!frames_queued_.empty()) {
+    delete[] frames_queued_.front();
+    frames_queued_.pop();
+  }
+}
+
+}  // namespace rex::audio::ps4
