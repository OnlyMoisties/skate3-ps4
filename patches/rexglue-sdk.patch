+/**
+ * @file        rex/core/fiber_ps4.cpp
+ * @brief       PS4 backend for rex::thread::Fiber
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * The console's ucontext is unusable for fibers: libkernel's getcontext and libSceLibcInternal's
+ * makecontext disagree about the context layout, and a fiber built with them never runs (measured
+ * with the Skate 3 platform probe, 2026-09-29). This is a SysV callee-saved switch instead, the same
+ * one the probe then ran on hardware: it saves rbx rbp r12-r15, MXCSR and the x87 control word on
+ * the outgoing stack and keeps only the stack pointer in the Fiber.
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_PS4
+
+#include <rex/thread/fiber.h>
+
+#include <cassert>
+#include <cstdint>
+
+extern "C" void rex_ps4_fiber_switch(void** from_sp, void* to_sp);
+asm(R"(
+  .text
+  .globl rex_ps4_fiber_switch
+  .type rex_ps4_fiber_switch,@function
+rex_ps4_fiber_switch:
+  pushq %rbp
+  pushq %rbx
+  pushq %r12
+  pushq %r13
+  pushq %r14
+  pushq %r15
+  subq $16, %rsp
+  stmxcsr 8(%rsp)
+  fnstcw (%rsp)
+  movq %rsp, (%rdi)
+  movq %rsi, %rsp
+  ldmxcsr 8(%rsp)
+  fldcw (%rsp)
+  addq $16, %rsp
+  popq %r15
+  popq %r14
+  popq %r13
+  popq %r12
+  popq %rbx
+  popq %rbp
+  ret
+  .size rex_ps4_fiber_switch, .-rex_ps4_fiber_switch
+)");
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+namespace {
+
+// Lays out a fresh stack so the first switch into it "returns" into `entry` with the SysV entry
+// alignment (rsp % 16 == 8) and the current MXCSR / x87 control word.
+void* PrepareStack(uint8_t* stack, size_t size, void (*entry)()) {
+  auto* sp = reinterpret_cast<uint64_t*>(reinterpret_cast<uintptr_t>(stack + size) & ~uintptr_t(15));
+  *--sp = 0;                                   // fake return address of entry
+  *--sp = reinterpret_cast<uint64_t>(entry);   // the switch's ret target
+  for (int i = 0; i < 6; i++) *--sp = 0;       // rbp rbx r12 r13 r14 r15
+  sp -= 2;                                     // x87 control word at +0, MXCSR at +8
+  uint32_t mxcsr;
+  uint16_t fcw;
+  asm volatile("stmxcsr %0" : "=m"(mxcsr));
+  asm volatile("fnstcw %0" : "=m"(fcw));
+  reinterpret_cast<uint16_t*>(sp)[0] = fcw;
+  reinterpret_cast<uint32_t*>(sp)[2] = mxcsr;
+  return sp;
+}
+
+}  // namespace
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;  // sp_ is filled the first time this thread switches away
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+  f->sp_ = PrepareStack(f->stack_.data(), f->stack_.size(), &Fiber::Trampoline);
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+  // A fiber entry must switch away rather than return; there is nothing to return into.
+  assert(false && "fiber entry returned");
+  for (;;) {
+  }
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_ps4_fiber_switch(&from->sp_, target->sp_);
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    tls_current_ = nullptr;
+  } else {
+    assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  }
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#endif  // REX_PLATFORM_PS4
