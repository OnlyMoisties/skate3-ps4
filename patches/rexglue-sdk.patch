+/**
+ * @file        rex/ui/surface_ps4.h
+ * @brief       The PS4's one display, as a presentation surface
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <rex/ui/surface.h>
+
+namespace rex {
+namespace ui {
+
+// There is no window system on the console: the Vulkan presenter creates a VK_EXT_headless_surface
+// for this, and mesa-ps4's WSI turns that swapchain's presents into sceVideoOut flips.
+class PS4DisplaySurface final : public Surface {
+ public:
+  PS4DisplaySurface(uint32_t width, uint32_t height) : width_(width), height_(height) {}
+  TypeIndex GetType() const override { return kTypeIndex_PS4Display; }
+
+ protected:
+  bool GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const override {
+    width_out = width_;
+    height_out = height_;
+    return true;
+  }
+
+ private:
+  uint32_t width_;
+  uint32_t height_;
+};
+
+}  // namespace ui
+}  // namespace rex
