+namespace rex::ui::ps4_stats {
+extern std::atomic<uint64_t> paint_requests, paint_coalesced, paint_started, paint_finished;
+extern std::atomic<uint64_t> ui_loop_iterations, ui_functions_started, ui_functions_finished;
+extern std::atomic<uint64_t> refresh_calls, refresh_inactive, refresh_impl_failed;
+extern std::atomic<uint64_t> refresh_mode[3];
+extern std::atomic<uint64_t> paint_results[6];
+extern std::atomic<uint64_t> recovery_requests, recovery_requests_skipped;
+extern std::atomic<uint64_t> connect_results[4];
+extern std::atomic<uint32_t> connection_state, paint_mode;
+extern std::atomic<uint64_t> swap_calls, swap_skipped_async, swap_null_view;
+extern std::atomic<uint64_t> ui_paint_exits[4];
+}  // namespace rex::ui::ps4_stats
+
+namespace {
+
+void StartStallWatchdog(uint64_t ui_stack_top) {
+  g_ui_thread = pthread_self();
+  g_ui_stack_top = ui_stack_top;
+  unlink(REX_PS4_DATA_DIR "/stall.txt");
+  struct sigaction sa = {};
+  sa.sa_sigaction = StallSignal;
+  sa.sa_flags = SA_SIGINFO | SA_RESTART | SA_ONSTACK;
+  sigemptyset(&sa.sa_mask);
+  sigaction(SIGXFSZ, &sa, nullptr);
+  std::thread([]() {
+    namespace st = rex::ui::ps4_stats;
+    uint64_t last_finished = 0;
+    int still_ms = 0, since_note_ms = 0;
+    size_t min_free = SIZE_MAX;
+    for (uint32_t tick = 1;; ++tick) {
+      usleep(250 * 1000);
+      if (tick % 40 == 0) {
+        size_t free_bytes = 0;
+        if (sceKernelAvailableFlexibleMemorySize(&free_bytes) == 0) {
+          min_free = std::min(min_free, free_bytes);
+          size_t heap_direct = 0, heap_flexible = 0;
+          uint32_t heap_failures = 0;
+          int32_t heap_error = 0;
+          rex_ps4_heap_stats(&heap_direct, &heap_flexible, &heap_failures, &heap_error);
+          REXLOG_INFO(
+              "PS4 memory: flexible free {} MB (lowest {} MB) | malloc heap: {} MB direct, {} MB "
+              "flexible, {} failed direct requests (last {:08X})",
+              free_bytes >> 20, min_free >> 20, heap_direct >> 20, heap_flexible >> 20,
+              heap_failures, uint32_t(heap_error));
+        }
+      }
+      const uint64_t finished = st::paint_finished.load();
+      if (finished != last_finished) {
+        if (still_ms >= 3000) BootMark("stall watchdog: paints resumed");
+        last_finished = finished;
+        still_ms = 0;
+        continue;
+      }
+      still_ms += 250;
+      since_note_ms += 250;
+      if (finished < 60 || still_ms < 3000) continue;
+      if (still_ms > 3000 && since_note_ms < 5000) continue;
+      const int note = g_stall_note_index.fetch_add(1);
+      if (note >= 6) continue;
+      since_note_ms = 0;
+      char line[1024];
+      auto u = [](const std::atomic<uint64_t>& a) { return (unsigned long long)a.load(); };
+      int n = std::snprintf(
+          line, sizeof line,
+          "stall note %d after %d ms: paint requests %llu coalesced %llu started %llu finished "
+          "%llu | ui loop %llu, functions started %llu finished %llu | swaps %llu (async-skip "
+          "%llu, null %llu) | refresh %llu inactive %llu failed %llu, mode none/ui/guest "
+          "%llu/%llu/%llu | paint results %llu/%llu/%llu/%llu/%llu/%llu | recovery requests %llu "
+          "skipped %llu | connect results %llu/%llu/%llu/%llu | connection state %u paint mode "
+          "%u\n",
+          note, still_ms, u(st::paint_requests), u(st::paint_coalesced), u(st::paint_started),
+          (unsigned long long)finished, u(st::ui_loop_iterations), u(st::ui_functions_started),
+          u(st::ui_functions_finished), u(st::swap_calls), u(st::swap_skipped_async),
+          u(st::swap_null_view), u(st::refresh_calls), u(st::refresh_inactive),
+          u(st::refresh_impl_failed), u(st::refresh_mode[0]), u(st::refresh_mode[1]),
+          u(st::refresh_mode[2]), u(st::paint_results[0]), u(st::paint_results[1]),
+          u(st::paint_results[2]), u(st::paint_results[3]), u(st::paint_results[4]),
+          u(st::paint_results[5]), u(st::recovery_requests), u(st::recovery_requests_skipped),
+          u(st::connect_results[0]), u(st::connect_results[1]), u(st::connect_results[2]),
+          u(st::connect_results[3]), st::connection_state.load(), st::paint_mode.load());
+      if (n >= int(sizeof line)) n = int(sizeof line) - 1;
+      if (n > 0 && n < int(sizeof line) - 120) {
+        n--;  // drop the newline, append the paint exits
+        n += std::snprintf(line + n, sizeof line - size_t(n),
+                           " | ui paint exits monitor/nothing/unpaintable/painted "
+                           "%llu/%llu/%llu/%llu\n",
+                           u(st::ui_paint_exits[0]), u(st::ui_paint_exits[1]),
+                           u(st::ui_paint_exits[2]), u(st::ui_paint_exits[3]));
+      }
+      AppendToFile(REX_PS4_DATA_DIR "/stall.txt", line, size_t(n));
+      if (note == 0) BootMark("stall watchdog: display stalled, see stall.txt");
+      REXLOG_WARN("PS4 stall watchdog: {}", std::string(line, size_t(n - 1)));
+      pthread_kill(g_ui_thread, SIGXFSZ);
+    }
+  }).detach();
+}
+
+std::string g_game_root = REX_PS4_DATA_DIR "/game";
+
+std::vector<std::string> BuildArguments() {
+  std::vector<std::string> args = {
+      "eboot.bin",
+      "--log_file=" REX_PS4_DATA_DIR "/log.txt",
+      "--game_data_root=" + g_game_root,
+  };
+  if (!g_debug) args.push_back("--log_level=off");
+  std::ifstream file(REX_PS4_DATA_DIR "/args.txt");
+  std::string line;
+  while (std::getline(file, line)) {
+    while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) line.pop_back();
+    if (line.empty() || line[0] == '#') continue;
+    // "env NAME=VALUE" sets an environment variable instead (there is no shell to set one).
+    if (line.rfind("env ", 0) == 0) {
+      const std::string assignment = line.substr(4);
+      const size_t eq = assignment.find('=');
+      if (eq != std::string::npos) {
+        setenv(assignment.substr(0, eq).c_str(), assignment.substr(eq + 1).c_str(), 1);
+        DebugOut("rexglue: env " + assignment);
+      }
+      continue;
+    }
+    args.push_back(line);
+  }
+  return args;
+}
+
+// A system notification (the pop-up in the top-left corner).
+void Notify(const char* text) {
+  struct {
+    int32_t type, req_id, priority, msg_id, target_id, user_id, unk1, unk2, app_id, error_num,
+        unk3;
+    uint8_t use_icon_image_uri;
+    char message[1024];
+    char icon_uri[1024];
+    char unk[1024];
+  } request;
+  std::memset(&request, 0, sizeof(request));
+  request.target_id = -1;
+  request.use_icon_image_uri = 1;
+  std::snprintf(request.message, sizeof(request.message), "%s", text);
+  std::snprintf(request.icon_uri, sizeof(request.icon_uri), "%s",
+                "cxml://psnotification/tex_icon_system");
+  sceKernelSendNotificationRequest(0, &request, sizeof(request), 0);
+}
+
+// ---- first-launch defaults, so the package works on a console that has only the game files ----
+//
+// The package carries /app0/defaults/: settings.toml (the PS4 profile) and save/ (a starter save
+// for the default offline profile). Each is copied into the data folder only when missing, so a
+// player's own settings and progress are never overwritten.
+
+bool FileExists(const char* path) {
+  struct stat st;
+  return stat(path, &st) == 0;
+}
+
+void MakeDirs(const std::string& path) {
+  for (size_t i = 1; i < path.size(); ++i) {
+    if (path[i] == '/') mkdir(path.substr(0, i).c_str(), 0777);
+  }
+  mkdir(path.c_str(), 0777);
+}
+
+bool CopyFile(const char* from, const std::string& to) {
+  FILE* in = std::fopen(from, "rb");
+  if (!in) return false;
+  const size_t slash = to.rfind('/');
+  if (slash != std::string::npos) MakeDirs(to.substr(0, slash));
+  FILE* out = std::fopen(to.c_str(), "wb");
+  if (!out) {
+    std::fclose(in);
+    return false;
+  }
+  char buffer[64 * 1024];
+  size_t n;
+  bool ok = true;
+  while ((n = std::fread(buffer, 1, sizeof(buffer), in)) > 0) {
+    if (std::fwrite(buffer, 1, n, out) != n) {
+      ok = false;
+      break;
+    }
+  }
+  std::fclose(in);
+  std::fclose(out);
+  return ok;
+}
+
+void InstallDefaults() {
+  const std::string data = REX_PS4_DATA_DIR;
+  if (!FileExists((data + "/settings.toml").c_str()) &&
+      CopyFile("/app0/defaults/settings.toml", data + "/settings.toml")) {
+    BootMark("defaults: settings.toml installed");
+  } else if (!FileExists((data + "/settings.toml").c_str())) {
+    BootMark("defaults: settings.toml could NOT be installed");
+  }
+  // The runtime's default offline profile (user_profile_xuid B13E07DFF9AB6772) and Skate 3's
+  // title id 454108E6: the same path on every console.
+  const std::string profile = data + "/B13E07DFF9AB6772/454108E6";
+  const std::string save = profile + "/00000001/ALIAS_SKATER";
+  if (!FileExists((save + "/SKATER.P").c_str()) &&
+      CopyFile("/app0/defaults/save/SKATER.P", save + "/SKATER.P") &&
+      CopyFile("/app0/defaults/save/RMCDEL", save + "/RMCDEL") &&
+      CopyFile("/app0/defaults/save/ALIAS_SKATER.header",
+               profile + "/Headers/00000001/ALIAS_SKATER.header")) {
+    BootMark("defaults: starter save installed");
+  }
+}
+
+[[noreturn]] void Idle(int result) {
+  DebugOut("rexglue: app finished (" + std::to_string(result) +
+           "); idling - close it from the PS button menu");
+  for (;;) {
+    sleep(1);
+  }
+}
