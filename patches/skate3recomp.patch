+#if defined(__PS4__)
+// One poll of the D3D wait-for-GPU loop (ring-buffer space / fence; returns 1 while the caller
+// should keep waiting). On the Xbox 360 its db16cyc instructions pause the hardware thread; the
+// recompile turns them into nothing, so the render thread spun flat out on a core the GPU command
+// thread needed (~18% of the render thread in gameplay). Back off progressively within a wait:
+// pause instructions, then yield the core, then short sleeps if the wait drags on.
+extern "C" REX_FUNC(sub_82B76080) {
+  __imp__sub_82B76080(ctx, base);
+  if (ctx.r3.u32 == 0) {
+    return;
+  }
+  thread_local uint64_t s_last_tsc = 0;
+  thread_local uint32_t s_polls = 0;
+  const uint64_t now = __rdtsc();
+  if (now - s_last_tsc > 1600000) {  // ~1 ms at 1.6 GHz since the last poll: a new wait
+    s_polls = 0;
+  }
+  s_last_tsc = now;
+  const uint32_t polls = ++s_polls;
+  if (polls < 32) {
+    for (int i = 0; i < 8; ++i) _mm_pause();
+  } else if (polls < 64) {
+    sched_yield();
+  } else {
+    usleep(50);
+  }
+}
+#endif
+
+#if defined(__PS4__)
+// The job system's "claim a job" (called through its function table): returns 0 when the queue
+// has nothing to claim. The main thread calls it in a loop while it waits for the workers, which
+// on the PS4 took ~25% of a core it shares with them. Same progressive back-off as the D3D wait.
+extern "C" REX_FUNC(sub_8290AFA0) {
+  __imp__sub_8290AFA0(ctx, base);
+  thread_local uint64_t s_last_tsc = 0;
+  thread_local uint32_t s_misses = 0;
+  if (ctx.r3.u32 != 0) {
+    s_misses = 0;
+    return;
+  }
+  const uint64_t now = __rdtsc();
+  if (now - s_last_tsc > 1600000) {  // ~1 ms since the last empty poll: a new wait
+    s_misses = 0;
+  }
+  s_last_tsc = now;
+  const uint32_t misses = ++s_misses;
+  if (misses < 16) {
+    for (int i = 0; i < 8; ++i) _mm_pause();
+  } else if (misses < 128) {
+    sched_yield();
+  } else {
+    usleep(20);
+  }
+}
+#endif
