diff --git a/src/skate3_ps4_vp6.cpp b/src/skate3_ps4_vp6.cpp
new file mode 100644
index 0000000..2a39965
--- /dev/null
+++ b/src/skate3_ps4_vp6.cpp
@@ -0,0 +1,204 @@
+// PS4: Skate 3's FMV (EA .vp6, VP6 1280x720) decoded by FFmpeg instead of the game's own
+// decoder. The recompiled VMX128 decoder (sub_82AF4B58 under sub_82AF3488) needed three
+// Jaguar cores and still dropped to a few fps; FFmpeg's C VP6 decoder is a fraction of that.
+//
+// Hook point: VideoDecoder_Vp6::Decode (vtable 0x8231B62C slot +16), called by the
+// "MoviePlayer2 Decode Thread" once per compressed video chunk (MV0K/MV0F payload):
+//   r3 = decoder, r4 = payload, r5 = size, r6 = frame index,
+//   r7 = callback 0x82A8F120, r8/r9 = its arguments (packet, MovieDecoder).
+// The callback releases the packet (frees its bytes) and returns a free VideoRenderable R, whose
+// Y/U/V destinations are R+8/+12/+16 (or one I420 block at R+8 when R+80 == 1) with pitches
+// R+40/+44/+48, format R+72 (3/4 = planar), frame index R+76 and ready byte R+88. Nothing outside
+// the game's VP6 code reads its own decoder state, so all of it is bypassed.
+//
+// VP6 stores frames bottom-up. FFmpeg's VP6 decoder returns them upright; the game's decoder did
+// not and the renderer flips at draw time (R+109), so rows are written in reverse.
+
+#if defined(__PS4__)
+
+#include "generated/skate3_init.h"
+
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavutil/frame.h>
+}
+
+REXCVAR_DEFINE_BOOL(skate3_ps4_native_vp6, true, "Skate 3",
+                    "PS4: decode FMV (EA VP6 movies) with FFmpeg instead of the game's "
+                    "recompiled decoder, which is too slow on the console's CPU.")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+namespace {
+
+struct Vp6Stream {
+  AVCodecContext* codec = nullptr;
+  AVFrame* frame = nullptr;
+  AVPacket* packet = nullptr;
+  int64_t last_index = -2;
+  bool need_keyframe = true;
+  bool logged = false;
+  bool frame_valid = false;
+};
+
+std::mutex g_streams_mutex;
+std::unordered_map<uint32_t, Vp6Stream*> g_streams;
+
+void FreeStream(Vp6Stream* s) {
+  if (!s) return;
+  av_packet_free(&s->packet);
+  av_frame_free(&s->frame);
+  avcodec_free_context(&s->codec);
+  delete s;
+}
+
+Vp6Stream* GetStream(uint32_t decoder) {
+  std::lock_guard<std::mutex> lock(g_streams_mutex);
+  auto it = g_streams.find(decoder);
+  if (it != g_streams.end()) return it->second;
+  const AVCodec* vp6 = avcodec_find_decoder(AV_CODEC_ID_VP6);
+  if (!vp6) return nullptr;
+  auto* s = new Vp6Stream();
+  s->codec = avcodec_alloc_context3(vp6);
+  s->frame = av_frame_alloc();
+  s->packet = av_packet_alloc();
+  if (!s->codec || !s->frame || !s->packet) {
+    FreeStream(s);
+    return nullptr;
+  }
+  s->codec->thread_count = 1;  // already on the game's own decode thread
+  if (avcodec_open2(s->codec, vp6, nullptr) < 0) {
+    FreeStream(s);
+    return nullptr;
+  }
+  g_streams.emplace(decoder, s);
+  return s;
+}
+
+void ForgetStream(uint32_t decoder) {
+  Vp6Stream* s = nullptr;
+  {
+    std::lock_guard<std::mutex> lock(g_streams_mutex);
+    auto it = g_streams.find(decoder);
+    if (it == g_streams.end()) return;
+    s = it->second;
+    g_streams.erase(it);
+  }
+  FreeStream(s);
+}
+
+// Rows reversed (see the header comment).
+void CopyPlane(uint8_t* dst, uint32_t dst_pitch, const uint8_t* src, int src_pitch, int width,
+               int height) {
+  for (int y = 0; y < height; ++y) {
+    std::memcpy(dst + size_t(y) * dst_pitch, src + size_t(height - 1 - y) * src_pitch,
+                size_t(width));
+  }
+}
+
+}  // namespace
+
+// VideoDecoder_Vp6::Decode
+extern "C" REX_FUNC(sub_82AA7218) {
+  if (!REXCVAR_GET(skate3_ps4_native_vp6)) {
+    __imp__sub_82AA7218(ctx, base);
+    return;
+  }
+  const uint32_t self = ctx.r3.u32;
+  const uint32_t data = ctx.r4.u32;
+  const uint32_t size = ctx.r5.u32;
+  const int32_t index = ctx.r6.s32;
+  const uint32_t callback = ctx.r7.u32;
+  const uint32_t cb_arg0 = ctx.r8.u32;
+  const uint32_t cb_arg1 = ctx.r9.u32;
+  REX_STORE_U32(self + 8, uint32_t(index));
+
+  Vp6Stream* s = GetStream(self);
+  bool have_frame = false;
+  if (s && size > 0 && size < (64u << 20)) {
+    const uint8_t* payload = reinterpret_cast<const uint8_t*>(REX_RAW_ADDR(data));
+    const bool keyframe = (payload[0] & 0x80) == 0;
+    if (index == 0 || index != s->last_index + 1) {
+      // A new movie on a reused decoder, or a seek: restart at the next keyframe.
+      avcodec_flush_buffers(s->codec);
+      s->need_keyframe = true;
+    }
+    s->last_index = index;
+    if (keyframe) s->need_keyframe = false;
+    if (!s->need_keyframe && av_new_packet(s->packet, int(size)) == 0) {
+      std::memcpy(s->packet->data, payload, size);
+      if (avcodec_send_packet(s->codec, s->packet) == 0 &&
+          avcodec_receive_frame(s->codec, s->frame) == 0) {
+        have_frame = true;
+        s->frame_valid = true;
+      }
+      av_packet_unref(s->packet);
+    }
+    if (!s->logged && have_frame) {
+      s->logged = true;
+      REXLOG_INFO(
+          "PS4 VP6: decoder {:08X} ({}x{} guest, {}x{} FFmpeg, fmt {}), first frame {} "
+          "(key {}, {} bytes, mode byte {})",
+          self, REX_LOAD_U32(self + 12), REX_LOAD_U32(self + 16), s->frame->width,
+          s->frame->height, s->frame->format, index, keyframe, size, REX_LOAD_U8(self + 36));
+    }
+  }
+
+  // The callback consumes the packet and hands back the output VideoRenderable.
+  ctx.r3.u64 = cb_arg0;
+  ctx.r4.u64 = cb_arg1;
+  REX_CALL_INDIRECT_FUNC(callback);
+  const uint32_t r = ctx.r3.u32;
+
+  if (r != 0) {
+    const uint32_t format = REX_LOAD_U32(r + 72);
+    if (s && s->frame_valid && (format == 3 || format == 4) &&
+        s->frame->format == AV_PIX_FMT_YUV420P) {
+      const int w = s->frame->width;
+      const int h = s->frame->height;
+      uint32_t y_addr, u_addr, v_addr, y_pitch, u_pitch, v_pitch;
+      if (REX_LOAD_U32(r + 80) == 1) {
+        y_addr = REX_LOAD_U32(r + 8);
+        u_addr = y_addr + uint32_t(w * h);
+        v_addr = y_addr + uint32_t(w * h * 5 / 4);
+        y_pitch = uint32_t(w);
+        u_pitch = v_pitch = uint32_t(w / 2);
+      } else {
+        y_addr = REX_LOAD_U32(r + 8);
+        u_addr = REX_LOAD_U32(r + 12);
+        v_addr = REX_LOAD_U32(r + 16);
+        y_pitch = REX_LOAD_U32(r + 40);
+        u_pitch = REX_LOAD_U32(r + 44);
+        v_pitch = REX_LOAD_U32(r + 48);
+      }
+      if (y_addr && u_addr && v_addr && y_pitch >= uint32_t(w) && u_pitch >= uint32_t(w / 2) &&
+          v_pitch >= uint32_t(w / 2)) {
+        CopyPlane(reinterpret_cast<uint8_t*>(REX_RAW_ADDR(y_addr)), y_pitch, s->frame->data[0], s->frame->linesize[0], w, h);
+        CopyPlane(reinterpret_cast<uint8_t*>(REX_RAW_ADDR(u_addr)), u_pitch, s->frame->data[1], s->frame->linesize[1], w / 2,
+                  h / 2);
+        CopyPlane(reinterpret_cast<uint8_t*>(REX_RAW_ADDR(v_addr)), v_pitch, s->frame->data[2], s->frame->linesize[2], w / 2,
+                  h / 2);
+        REX_STORE_U32(r + 56, uint32_t(w));
+        REX_STORE_U32(r + 60, uint32_t(h));
+      }
+    }
+    REX_STORE_U32(r + 76, uint32_t(index));
+    REX_STORE_U8(r + 88, 1);
+  }
+  ctx.r3.u64 = 1;
+}
+
+// VideoDecoder_Vp6::Shutdown: drop our FFmpeg state with the guest's.
+extern "C" REX_FUNC(sub_82AA7098) {
+  ForgetStream(ctx.r3.u32);
+  __imp__sub_82AA7098(ctx, base);
+}
+
+#endif  // __PS4__
